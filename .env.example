# Sanity (blog CMS) — get these from https://www.sanity.io/manage after creating a project.
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Optional: enable Visual Editing overlays in Sanity Studio.
# PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true

# Optional: API token for reading drafts (Visual Editing). Generate at sanity.io/manage → API → Tokens.
# SANITY_API_READ_TOKEN=skXXXXXXXXX
