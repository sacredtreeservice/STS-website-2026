---
import { Icon } from 'astro-icon/components';
import { company } from '../data/company';

// Reviews replaces Careers up here — social proof is a top-3 conversion
// asset and was previously reachable only from the footer. Careers still
// lives in the footer's Company column.
const navLinks = [
  { href: '/services/', label: 'Services' },
  { href: '/service-area/', label: 'Service Area' },
  { href: '/tree-care/', label: 'Tree Care' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">
      <img src="/assets/logo.jpg" alt={company.brandName} width="48" height="48" />
      <span>
        <strong>{company.brandName}</strong>
        <em>{company.tagline}</em>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Main">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="cta" href={company.phoneHref}><Icon name="lucide:phone" /> {company.phone}</a>
    <button class="hamburger" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
      <Icon name="lucide:menu" />
    </button>
  </div>

  <div class="mobile-menu" data-menu-panel aria-hidden="true">
    <div class="mobile-menu-inner">
      <header class="mobile-menu-header">
        <span class="brand-mini">{company.brandName}</span>
        <button class="close" type="button" aria-label="Close menu" data-menu-toggle>
          <Icon name="lucide:x" />
        </button>
      </header>
      <nav aria-label="Mobile">
        {navLinks.map((l) => <a href={l.href}>{l.label} <Icon name="lucide:arrow-right" /></a>)}
      </nav>
      <div class="mobile-actions">
        <a class="btn primary large" href={company.phoneHref}>
          <Icon name="lucide:phone" /> Call {company.phone}
        </a>
        <a class="btn ghost large" href={`mailto:${company.email}`}>
          <Icon name="lucide:mail" /> Email Us
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Bound once for the page's lifetime (module runs once; the astro:page-load
  // listener persists across view-transition navigations).
  let escBound = false;

  const initMobileMenu = () => {
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    if (!panel) return;
    const toggles = document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]');

    const open = () => {
      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      toggles.forEach((b) => b.setAttribute('aria-expanded', 'true'));
    };
    const close = () => {
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      toggles.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    };

    // Bind each control EXACTLY once. initMobileMenu runs on the initial load
    // AND on every astro:page-load; without these per-element guards the toggle
    // gets a second click listener and a tap opens-then-closes (menu "won't
    // open"). After a navigation the header is re-rendered with fresh elements
    // (no flag), so they bind correctly then too.
    toggles.forEach((btn) => {
      if (btn.dataset.menuBound) return;
      btn.dataset.menuBound = 'true';
      btn.addEventListener('click', () => (panel.classList.contains('is-open') ? close() : open()));
    });

    if (!panel.dataset.menuBound) {
      panel.dataset.menuBound = 'true';
      // Close on link click within the panel
      panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
      // Close on backdrop click
      panel.addEventListener('click', (e) => {
        if (e.target === panel) close();
      });
    }

    // Close on Escape — attach to document once only.
    if (!escBound) {
      escBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const p = document.querySelector<HTMLElement>('[data-menu-panel]');
        if (p?.classList.contains('is-open')) {
          p.classList.remove('is-open');
          p.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          document
            .querySelectorAll<HTMLButtonElement>('[data-menu-toggle]')
            .forEach((b) => b.setAttribute('aria-expanded', 'false'));
        }
      });
    }
  };

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand img { border-radius: 6px; }
  .brand strong {
    font-family: 'Marcellus', Georgia, serif;
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--green-dark);
    display: block;
    line-height: 1.1;
  }
  .brand em {
    font-style: normal;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .desktop-nav {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }
  .desktop-nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .desktop-nav a:hover { color: var(--green); }
  .cta {
    background: var(--green);
    color: #0c100a;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.2s ease, transform 0.2s var(--easing);
  }
  :root[data-theme='light'] .cta { color: #fff; }
  .cta:hover { background: var(--green-light); transform: translateY(-1px); }
  :root[data-theme='light'] .cta:hover { background: var(--green-dark); color: #fff; }
  .cta [data-icon] { width: 14px; height: 14px; }

  .hamburger {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    place-items: center;
    transition: border-color 0.2s ease;
  }
  .hamburger:hover { border-color: var(--green); }
  .hamburger [data-icon] { width: 22px; height: 22px; }

  /* Mobile menu panel — hidden + non-interactive when closed so it doesn't
     trap clicks across the whole page on desktop. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background: rgba(8, 14, 12, 0.55);
    z-index: 100;
    display: flex;
    justify-content: flex-end;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
  }
  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.25s ease, visibility 0s linear 0s;
  }
  .mobile-menu-inner {
    background: var(--paper);
    width: min(360px, 90vw);
    height: 100%;
    padding: 1.25rem 1.25rem 2rem;
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    transition: transform 0.3s var(--easing);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
  }
  .mobile-menu.is-open .mobile-menu-inner { transform: translateX(0); }
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .brand-mini {
    font-family: 'Marcellus', Georgia, serif;
    font-size: 1rem;
    color: var(--green-dark);
  }
  .close {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .close [data-icon] { width: 20px; height: 20px; }
  .mobile-menu nav { display: flex; flex-direction: column; gap: 0.25rem; }
  .mobile-menu nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: all 0.2s var(--easing);
  }
  .mobile-menu nav a:hover {
    border-color: var(--green);
    background: var(--green-tint);
  }
  .mobile-menu nav a [data-icon] {
    width: 18px;
    height: 18px;
    color: var(--green);
    opacity: 0.6;
    transition: opacity 0.2s ease, transform 0.2s var(--easing);
  }
  .mobile-menu nav a:hover [data-icon] { opacity: 1; transform: translateX(2px); }
  .mobile-actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .mobile-actions .btn { justify-content: center; width: 100%; }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .brand em { display: none; }
    .cta { display: none; }
    .hamburger { display: grid; margin-left: auto; }
  }
</style>
