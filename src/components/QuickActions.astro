---
import { Icon } from 'astro-icon/components';

const actions = [
  {
    icon: 'lucide:leaf',
    title: 'Plant health & care',
    sub: 'Keep what you love thriving',
    href: '/services/plant-health-care/',
    tone: 'default',
  },
  {
    icon: 'lucide:scissors',
    title: 'Pruning & trimming',
    sub: 'Routine care that prevents problems',
    href: '/services/tree-pruning/',
    tone: 'default',
  },
  {
    icon: 'lucide:tree-deciduous',
    title: 'Removal & replanting',
    sub: 'Thoughtful, when it’s time',
    href: '/services/tree-removal/',
    tone: 'default',
  },
  {
    icon: 'lucide:clipboard-check',
    title: 'Free estimate',
    sub: 'In-person, no pressure',
    href: '/contact/',
    tone: 'accent',
  },
];
---

<section class="quick">
  <div class="container">
    <div class="grid" data-reveal data-reveal-stagger>
      {actions.map((a) => (
        <a href={a.href} class={`tile tone-${a.tone}`}>
          <span class="iconwrap"><Icon name={a.icon} /></span>
          <span class="text">
            <strong>{a.title}</strong>
            <em>{a.sub}</em>
          </span>
          <span class="arrow"><Icon name="lucide:arrow-right" /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .quick {
    margin: -2.5rem auto 0;
    position: relative;
    z-index: 5;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
    background: var(--surface);
    padding: 0.85rem;
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
  }
  .tile {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.1rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper-2);
    transition: transform 0.2s var(--easing), background 0.2s ease;
    position: relative;
    overflow: hidden;
  }
  .tile:hover { transform: translateY(-2px); background: var(--green-tint); }
  .tile.tone-accent { background: var(--green); color: #fff; }
  .tile.tone-accent:hover { background: var(--green-dark); }
  .tile.tone-accent .iconwrap { background: rgba(255,255,255,0.2); color: #fff; }
  .tile.tone-accent strong, .tile.tone-accent em { color: #fff; }
  .iconwrap {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--green-tint);
    color: var(--green-dark);
    display: grid;
    place-items: center;
  }
  .iconwrap [data-icon] { width: 22px; height: 22px; }
  .text { display: flex; flex-direction: column; line-height: 1.2; flex: 1; min-width: 0; }
  .text strong { font-weight: 700; font-size: 0.98rem; }
  .text em { font-style: normal; font-size: 0.82rem; color: var(--muted); margin-top: 2px; }
  .tile.tone-accent .text em { color: rgba(255,255,255,0.85); }
  .arrow {
    color: var(--green);
    transition: transform 0.2s var(--easing);
    flex-shrink: 0;
  }
  .arrow [data-icon] { width: 18px; height: 18px; }
  .tile:hover .arrow { transform: translateX(4px); }
  .tile.tone-accent .arrow { color: #fff; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .grid { grid-template-columns: 1fr; }
    .quick { margin-top: -1.5rem; }
  }
</style>
