---
import { Image } from 'astro:assets';
import work1 from '../assets/work/work-1.jpg';
import work2 from '../assets/work/work-2.jpg';
import work4 from '../assets/work/work-4.jpg';
import work6 from '../assets/work/work-6.jpg';

// Optimized via astro:assets — the originals were shipped raw (up to 1.1MB
// each) into 180px grid cells, dragging down mobile Core Web Vitals on the
// highest-traffic page.
const photos = [
  { src: work1, alt: 'Removal of a large hardwood' },
  { src: work2, alt: 'Crew working safely up in a tree' },
  { src: work4, alt: 'Climber pruning a mature canopy' },
  { src: work6, alt: 'Crane-loading a large log' },
];
---

<section class="gallery-section">
  <div class="container">
    <header class="head" data-reveal>
      <span class="kicker">From the field</span>
      <h2>Real jobs, real trees</h2>
      <p>A few snapshots from recent work across Central Florida.</p>
    </header>
    <div class="grid" data-reveal data-reveal-stagger>
      {photos.map((p, i) => (
        <figure class={`g g-${i}`}>
          <Image
            src={p.src}
            alt={p.alt}
            width={800}
            widths={[400, 800]}
            sizes="(max-width: 800px) 50vw, 600px"
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section { padding: 4rem 0; background: var(--paper-2); }
  .head { text-align: center; margin-bottom: 2.5rem; }
  .kicker {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  .head h2 { font-size: 2.2rem; margin: 0 0 0.4rem; }
  .head p { color: var(--muted); margin: 0; }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 180px;
    gap: 0.75rem;
  }
  .g {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--easing), box-shadow 0.3s ease;
  }
  .g:hover { transform: scale(1.02); box-shadow: var(--shadow-md); }
  .g img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .g-0 { grid-column: span 2; grid-row: span 2; }
  .g-1 { grid-column: span 2; grid-row: span 1; }
  .g-2 { grid-column: span 1; grid-row: span 1; }
  .g-3 { grid-column: span 1; grid-row: span 1; }
  @media (max-width: 800px) {
    .grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; }
    .g, .g-0, .g-1, .g-2, .g-3 { grid-column: span 1; grid-row: span 1; }
  }
</style>
