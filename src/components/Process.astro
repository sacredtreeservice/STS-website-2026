---
import { Icon } from 'astro-icon/components';

const steps = [
  { n: '01', icon: 'lucide:phone', title: 'You reach out', text: 'Call, text, or fill out the form. Real humans, no bots.' },
  { n: '02', icon: 'lucide:map-pin', title: 'We come look', text: 'Free in-person estimate, usually within a few business days.' },
  { n: '03', icon: 'lucide:file-text', title: 'You get a written quote', text: 'Clear scope, fair price, financing available on bigger projects.' },
  { n: '04', icon: 'lucide:check-circle-2', title: 'The crew shows up', text: 'Work done safely, site cleaned, walkthrough at the end.' },
];
---

<section class="process">
  <div class="container">
    <header class="head" data-reveal>
      <span class="kicker">How we work</span>
      <h2>Four steps. No surprises.</h2>
      <p>A simple, predictable process from first call to final cleanup.</p>
    </header>
    <ol class="steps" data-reveal data-reveal-stagger>
      {steps.map((s) => (
        <li>
          <span class="num">{s.n}</span>
          <span class="ico"><Icon name={s.icon} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { padding: 4rem 0; }
  .head { text-align: center; margin-bottom: 3rem; }
  .kicker {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  .head h2 { font-size: 2.2rem; margin: 0 0 0.4rem; }
  .head p { color: var(--muted); margin: 0; }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    counter-reset: step;
  }
  .steps li {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    border: 1px solid rgba(75, 112, 33, 0.1);
    transition: transform 0.2s var(--easing), box-shadow 0.2s ease;
  }
  .steps li:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .num {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-family: 'Marcellus', Georgia, serif;
    font-size: 1.4rem;
    color: rgba(75, 112, 33, 0.25);
  }
  .ico {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(75, 112, 33, 0.1);
    color: var(--green-dark);
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
  }
  .ico [data-icon] { width: 24px; height: 24px; }
  h3 { font-size: 1.15rem; margin: 0 0 0.35rem; }
  p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
