---
import { company } from '../data/company';

export interface Props {
  heading?: string;
  subheading?: string;
  /**
   * Optional context label shown above the form (e.g. "Tree Removal in Winter Park").
   * Helps the visitor self-select on a form that doesn't take URL params.
   */
  context?: string;
}

const {
  heading = 'Request a Free Estimate',
  subheading = 'Tell us about your trees and we’ll be in touch to schedule a visit.',
  context,
} = Astro.props;

// Jobber Work Request Form embed config.
// To replace this form, grab a fresh snippet from Jobber and update these three values.
const JOBBER_CLIENTHUB_ID = 'f668b8d3-2de5-4f31-9cea-bb01b8809b50-858671';
const JOBBER_FORM_URL =
  'https://clienthub.getjobber.com/client_hubs/f668b8d3-2de5-4f31-9cea-bb01b8809b50/public/work_request/embedded_work_request_form?form_id=858671';
const JOBBER_SCRIPT_SRC =
  'https://d3ey4dbjkt2f6s.cloudfront.net/assets/static_link/work_request_embed_snippet.js';
const JOBBER_CSS =
  'https://d3ey4dbjkt2f6s.cloudfront.net/assets/external/work_request_embed.css';
---

<link rel="stylesheet" href={JOBBER_CSS} media="screen" />

<section class="lead-form">
  <header>
    <h2>{heading}</h2>
    <p>{subheading}</p>
    {context && <p class="context">For: <strong>{context}</strong></p>}
  </header>

  <div class="jobber-mount">
    <div id={JOBBER_CLIENTHUB_ID}></div>
  </div>

  <p class="fallback-call">
    Prefer to talk? Call <a href={company.phoneHref}>{company.phone}</a>.
  </p>
</section>

<script is:inline define:vars={{ JOBBER_SCRIPT_SRC, JOBBER_CLIENTHUB_ID, JOBBER_FORM_URL }}>
  // Mount (or remount) the Jobber embed. Survives Astro view transitions:
  // each navigation re-fires astro:page-load, and we re-inject the loader
  // script if the new page's mount node is still empty.
  const initJobber = () => {
    const mount = document.getElementById(JOBBER_CLIENTHUB_ID);
    if (!mount) return;
    if (mount.querySelector('iframe')) return; // already mounted
    // Loader script may already be in flight from a prior call. Without this
    // guard, the inline call + astro:page-load listener can both fire before
    // the iframe is mounted, racing to inject two loaders → two iframes.
    const loaderId = `jobber-loader-${JOBBER_CLIENTHUB_ID}`;
    if (document.getElementById(loaderId)) return;
    const s = document.createElement('script');
    s.id = loaderId;
    s.src = JOBBER_SCRIPT_SRC;
    s.setAttribute('clienthub_id', JOBBER_CLIENTHUB_ID);
    s.setAttribute('form_url', JOBBER_FORM_URL);
    document.body.appendChild(s);
  };
  initJobber();
  document.addEventListener('astro:page-load', initJobber);
</script>

<style>
  .lead-form {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    padding: 2rem 1.75rem;
    box-shadow: var(--shadow-sm);
  }
  .lead-form header { margin-bottom: 1.25rem; }
  .lead-form h2 {
    font-family: 'Marcellus', Georgia, serif;
    font-weight: 400;
    color: var(--green-dark);
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
  }
  .lead-form p { margin: 0.25rem 0; color: var(--muted); }
  .context {
    background: var(--green-tint);
    color: var(--green-dark);
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    font-size: 0.9rem;
    display: inline-block;
  }
  .jobber-mount {
    margin: 1.25rem 0 0.75rem;
    /* Reserve close to the rendered iframe height so the form's late
       arrival doesn't push everything below it (CLS). Jobber's iframe
       maxes at 760px wide and centers itself; on narrow screens the
       fields stack and the form gets noticeably taller. */
    min-height: 820px;
  }
  @media (max-width: 600px) {
    .jobber-mount { min-height: 1080px; }
  }
  .fallback-call {
    margin: 1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
    color: var(--muted);
    text-align: center;
  }
  .fallback-call a {
    color: var(--green-dark);
    font-weight: 700;
    text-decoration: none;
  }
  .fallback-call a:hover { text-decoration: underline; }
</style>
