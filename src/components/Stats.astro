---
import { Icon } from 'astro-icon/components';
import { company } from '../data/company';

const yearsInBusiness = new Date().getFullYear() - new Date(company.founded).getFullYear();

const stats = [
  { icon: 'lucide:badge-check', value: 'ISA', label: 'Certified Arborists on staff' },
  { icon: 'lucide:shield-check', value: 'Licensed', label: 'Insured & workers’ comp' },
  { icon: 'lucide:map-pin', value: `${company.serviceRadiusMiles} mi`, label: 'Radius around Orlando HQ' },
  { icon: 'lucide:trees', value: '10+', label: 'Tree care services' },
];
---

<section class="stats">
  <div class="container">
    <ul class="row" data-reveal data-reveal-stagger>
      {stats.map((s) => (
        <li>
          <span class="ico"><Icon name={s.icon} /></span>
          <strong>{s.value}</strong>
          <em>{s.label}</em>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats {
    background: var(--green-dark);
    color: #e8efe0;
    padding: 3rem 0;
  }
  .row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    text-align: center;
  }
  .row li { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
  .ico {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(255,255,255,0.08);
    display: grid;
    place-items: center;
    color: #b9d093;
    margin-bottom: 0.4rem;
  }
  .ico [data-icon] { width: 26px; height: 26px; }
  strong {
    font-family: 'Marcellus', Georgia, serif;
    font-weight: 400;
    font-size: 1.6rem;
    color: #fff;
    line-height: 1;
  }
  em { font-style: normal; font-size: 0.92rem; color: #b9d093; }
  @media (max-width: 720px) {
    .row { grid-template-columns: 1fr 1fr; }
  }
</style>
