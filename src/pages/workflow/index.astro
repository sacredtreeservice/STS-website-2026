---
// Hidden field pricing guide — /workflow/ — for sales reps + owner only.
// NOT linked from anywhere on the site; staff type the URL manually.
// Kept out of search: meta noindex below + excluded from the sitemap in
// astro.config.mjs (same treatment as /book-a-call/).
//
// The password gate is convenience-only, verified in client-side JS — anyone
// who views source can read it. That's by design: prices aren't secret, the
// gate just keeps casual visitors out. To change the password, edit PASS in
// the gate script below. Changing it re-locks every remembered device.
//
// Content mirrors PRICING-GUIDE.md v1.3 (master doc in ~/Documents/Sacred
// Tree MSA). The .md, the Jobber catalog, and this page change together.
//
// UX: POS-style — categories collapsed on launch, tap a tile to add it to
// the ticket, adjust quantities in the ticket drawer at the bottom.
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Field Guide — Sacred Tree Service</title>
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <style is:inline>
    :root{
      --bg:#F7F6F2; --card:#FFFFFF; --ink:#1C221A; --muted:#5C665A; --line:#DDE2D8;
      --accent:#2F5233; --accent-ink:#FFFFFF; --chip:#EDF2EA;
      --good:#2E7D32; --warn:#B26A00; --bad:#B3261E; --bad-bg:#FBEAE8; --warn-bg:#FBF1E0; --good-bg:#E9F3E9;
    }
    @media (prefers-color-scheme: dark){:root{
      --bg:#141813; --card:#1D231B; --ink:#E8EBE4; --muted:#9AA694; --line:#333B30;
      --accent:#7FB069; --accent-ink:#10150E; --chip:#252D22;
      --good:#81C784; --warn:#E0A64E; --bad:#EF8A80; --bad-bg:#3A211E; --warn-bg:#372B18; --good-bg:#1F3320;
    }}
    *{box-sizing:border-box; margin:0}
    html,body{background:var(--bg); color:var(--ink);
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      -webkit-text-size-adjust:100%}

    /* ── Password gate ── */
    #gate{min-height:100dvh; display:flex; align-items:center; justify-content:center; padding:20px}
    #gate[hidden]{display:none} /* author display:flex would otherwise beat the hidden attr */
    .gate-card{background:var(--card); border:1px solid var(--line); border-radius:12px;
      padding:28px 24px; max-width:340px; width:100%; text-align:center}
    .gate-card h1{font-size:1.05rem; font-weight:800; letter-spacing:-.01em}
    .gate-card .gsub{color:var(--muted); font-size:.78rem; margin:4px 0 18px}
    .gate-card input{width:100%; height:46px; text-align:center; font-size:1.05rem; font-weight:600;
      border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--ink)}
    .gate-card input:focus{outline:2px solid var(--accent); outline-offset:-1px}
    .gate-card button{width:100%; margin-top:10px; height:46px; border:none; border-radius:8px;
      background:var(--accent); color:var(--accent-ink); font-size:.9rem; font-weight:700; cursor:pointer}
    #gateErr{color:var(--bad); background:var(--bad-bg); border-radius:7px;
      font-size:.76rem; font-weight:600; padding:7px 10px; margin-top:10px}

    /* ── Guide ── */
    .wrap{max-width:720px; margin:0 auto; padding:16px 14px 220px}
    header h1{font-size:1.35rem; font-weight:800; letter-spacing:-.01em}
    header .sub{color:var(--muted); font-size:.8rem; margin-top:2px}
    .rules{display:flex; flex-wrap:wrap; gap:6px; margin:12px 0 4px}
    .rule{background:var(--chip); border:1px solid var(--line); border-radius:6px;
      padding:5px 9px; font-size:.72rem; font-weight:600; color:var(--ink)}
    .rule b{color:var(--accent)}
    .dbh{font-size:.72rem; color:var(--muted); margin:6px 0 14px}
    section.cat{background:var(--card); border:1px solid var(--line); border-radius:10px; margin-bottom:12px; overflow:hidden}
    .cat h2{font-size:.8rem; text-transform:uppercase; letter-spacing:.08em; font-weight:800;
      padding:11px 14px; color:var(--accent); border-bottom:1px solid var(--line);
      display:flex; justify-content:space-between; align-items:center; gap:10px; cursor:pointer; user-select:none}
    .cat.collapsed h2{border-bottom:none}
    .cat h2 .hleft{display:flex; align-items:center; gap:8px; text-align:left}
    .cat h2 .chev{display:inline-block; font-size:.65rem; transition:transform .15s}
    .cat.collapsed .chev{transform:rotate(-90deg)}
    .cat h2 .catnote{font-size:.68rem; font-weight:600; color:var(--muted); text-transform:none; letter-spacing:0; text-align:right}
    .grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:8px; padding:12px}
    .collapsed .grid{display:none}
    .tile{position:relative; text-align:left; border:1px solid var(--line); border-radius:9px;
      background:var(--bg); color:var(--ink); padding:9px 10px 8px; cursor:pointer; font:inherit;
      touch-action:manipulation; display:flex; flex-direction:column; gap:3px; min-height:76px}
    .tile:active{border-color:var(--accent)}
    .tile.on{border-color:var(--accent); background:var(--chip)}
    .tile .tname{font-size:.8rem; font-weight:700; line-height:1.25;
      display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
    .tile .tnote{font-size:.62rem; color:var(--muted); line-height:1.3;
      display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
    .tile .tprice{font-size:.74rem; color:var(--muted); font-weight:600; margin-top:auto}
    .tile .tprice b{color:var(--ink); font-variant-numeric:tabular-nums}
    .tile .badge{position:absolute; top:-7px; right:-7px; min-width:22px; height:22px; padding:0 6px;
      border-radius:11px; background:var(--accent); color:var(--accent-ink); font-size:.72rem; font-weight:800;
      display:flex; align-items:center; justify-content:center; font-variant-numeric:tabular-nums}
    .tile .badge:empty{display:none}

    /* ── Ticket drawer + totals bar ── */
    .totals{position:fixed; left:0; right:0; bottom:0; background:var(--card); border-top:2px solid var(--accent);
      box-shadow:0 -4px 18px rgba(0,0,0,.12); z-index:10}
    .totals .inner{max-width:720px; margin:0 auto; padding:10px 14px}
    #ticket{max-height:32vh; overflow-y:auto; margin-bottom:6px; border-bottom:1px solid var(--line)}
    .tline{display:flex; align-items:center; gap:8px; padding:6px 0; border-top:1px solid var(--line)}
    .tline:first-child{border-top:none}
    .tline .ti{flex:1; min-width:0}
    .tline .ti .n{font-size:.78rem; font-weight:600; line-height:1.2}
    .tline .ti .u{font-size:.68rem; color:var(--muted); font-variant-numeric:tabular-nums}
    .tline .qc{display:flex; align-items:center}
    .tline .qc button{width:36px; height:36px; font-size:1.1rem; font-weight:700; border:1px solid var(--line);
      background:var(--chip); color:var(--ink); cursor:pointer; touch-action:manipulation}
    .tline .qc button:first-child{border-radius:7px 0 0 7px}
    .tline .qc button:last-child{border-radius:0 7px 7px 0}
    .tline .qc button:active{background:var(--accent); color:var(--accent-ink)}
    .tline .qc input{width:46px; height:36px; text-align:center; font-size:.92rem; font-weight:700;
      border:1px solid var(--line); border-left:none; border-right:none; background:var(--card); color:var(--ink);
      font-variant-numeric:tabular-nums}
    .tline .qc input:focus{outline:2px solid var(--accent); outline-offset:-2px}
    .tline .lamt{font-size:.8rem; font-weight:700; color:var(--accent); font-variant-numeric:tabular-nums;
      min-width:62px; text-align:right}
    .trow{display:flex; justify-content:space-between; align-items:baseline; font-size:.82rem; padding:1px 0}
    .trow.big{font-size:1.15rem; font-weight:800}
    .trow .amt{font-variant-numeric:tabular-nums; font-weight:700}
    #sumRow{cursor:pointer; user-select:none}
    .flag{border-radius:7px; padding:7px 10px; font-size:.76rem; font-weight:600; margin-top:6px}
    .flag.bad{background:var(--bad-bg); color:var(--bad)}
    .flag.warn{background:var(--warn-bg); color:var(--warn)}
    .flag.good{background:var(--good-bg); color:var(--good)}
    .controls{display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; align-items:center}
    .toggle{display:flex; align-items:center; gap:6px; font-size:.76rem; font-weight:600; color:var(--muted)}
    .toggle input{width:18px; height:18px; accent-color:var(--accent)}
    .daysin{display:flex; align-items:center; gap:6px; font-size:.76rem; font-weight:600; color:var(--muted)}
    .daysin input{width:56px; height:34px; text-align:center; border:1px solid var(--line); border-radius:7px;
      background:var(--bg); color:var(--ink); font-weight:700; font-size:.9rem}
    .btn{border:none; border-radius:8px; padding:9px 14px; font-size:.8rem; font-weight:700; cursor:pointer}
    .btn.primary{background:var(--accent); color:var(--accent-ink)}
    .btn.ghost{background:var(--chip); color:var(--ink); border:1px solid var(--line)}
    .footer-note{font-size:.68rem; color:var(--muted); margin-top:14px; line-height:1.5}
    @media (prefers-reduced-motion: no-preference){ .tile{transition:border-color .1s, background .1s} }
  </style>
</head>
<body>

<div id="gate">
  <form class="gate-card" id="gateForm">
    <h1>Sacred Tree Service</h1>
    <div class="gsub">Team access — ask the office if you need the password.</div>
    <input type="password" id="gatePass" autocomplete="current-password" autofocus
      placeholder="Password" aria-label="Password" />
    <button type="submit">Open field guide</button>
    <div id="gateErr" hidden>Wrong password — check with the office.</div>
  </form>
</div>

<div id="app" hidden>
<div class="wrap">
  <header>
    <h1>Sacred Tree Service — Field Pricing Guide</h1>
    <div class="sub">v1.3 · Effective Jul 8, 2026 · These are the prices. Qty × amount. No improvising. · Master: PRICING-GUIDE.md · Costs: STS-Master-Cost-Book.xlsx</div>
  </header>

  <div class="rules">
    <span class="rule"><b>$750</b> job minimum (standalone)</span>
    <span class="rule"><b>Never</b> below book — owner sign-off only</span>
    <span class="rule"><b>DBH required</b> on every removal &amp; big prune</span>
    <span class="rule">Removals: discount = <b>plan credit only</b></span>
    <span class="rule">&gt;20 mi out: <b>+$150 trip</b> or $1,500 min</span>
    <span class="rule">≥$2,500: collect <b>30% deposit</b></span>
  </div>
  <div class="dbh">DBH = trunk diameter at 4.5 ft. No caliper? Tape the circumference and divide by 3.14. When between bands, price the bigger band. Tap a category to open it, tap an item to add it to the ticket.</div>

  <div id="catalog"></div>

  <div class="footer-note">
    v1.3 · Rate basis: verified medians from 1,444 historical line items + in-house unit cost build-ups (commercial lines) + cost floors recomputed on the real 4-man crew (a crew-day must bill $3,500+; 2-man detachment days $1,750+; consulting/report visits exempt from the job minimum). Packages (Plant &amp; Establish, Full Canopy, Remove &amp; Renew, Oak Health, pond tiers) are sum-of-book — see PRICING-GUIDE.md Section 16.
    Member rate = −10% for signed MSA / Annual Plan clients only. Crane &amp; specialty rentals ×1.15 · plant material ×1.5 · subbed licensed work ×1.15.
    Storm work (members): book + 15% cap. Non-members: emergency rates, 50% deposit, card on file.
    Master document: PRICING-GUIDE.md — this calculator is a rendering of it; the .md and the Jobber catalog change together, owner + one admin only.
  </div>
</div>

<div class="totals">
  <div class="inner">
    <div id="flags"></div>
    <div id="ticket" style="display:none"></div>
    <div class="trow" id="sumRow"><span id="lineCount">No items yet — tap an item to build the quote</span><span class="amt" id="subtotal"></span></div>
    <div class="trow" id="memberRow" style="display:none"><span>Member rate (−10%)</span><span class="amt" id="memberAmt"></span></div>
    <div class="trow" id="minRow" style="display:none"><span>Job minimum applied</span><span class="amt">$750</span></div>
    <div class="trow big"><span>Quote total</span><span class="amt" id="total">$0</span></div>
    <div class="trow" id="depositRow" style="display:none; color:var(--warn)"><span id="depositLabel"></span><span class="amt" id="depositAmt"></span></div>
    <div class="controls">
      <label class="toggle"><input type="checkbox" id="member" /> MSA / Plan member</label>
      <label class="toggle"><input type="checkbox" id="addon" /> Add-on to existing visit</label>
      <span class="daysin">Crew-days on site: <input type="number" id="days" min="0" step="0.5" placeholder="—" /></span>
      <button class="btn primary" id="copy">Copy quote</button>
      <button class="btn ghost" id="reset">Reset</button>
    </div>
  </div>
</div>
</div><!-- /#app -->

<script is:inline>
// ── Gate ── convenience lock only; the password is visible in this source.
(function(){
  const PASS = 'sacredcrew';           // ← change the password here
  const KEY  = 'sts_workflow_pass';    // remembered per device after first unlock
  const gate = document.getElementById('gate');
  const app  = document.getElementById('app');
  function unlock(){ gate.hidden = true; app.hidden = false; }
  try { if (localStorage.getItem(KEY) === PASS) unlock(); } catch (e) {}
  document.getElementById('gateForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('gatePass');
    if (input.value.trim() === PASS) {
      try { localStorage.setItem(KEY, PASS); } catch (err) {}
      unlock();
    } else {
      document.getElementById('gateErr').hidden = false;
      input.value = '';
      input.focus();
    }
  });
})();
</script>

