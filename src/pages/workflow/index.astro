const fmt = n => '$' + Math.round(n).toLocaleString('en-US');
const qty = {}; // id -> qty
let idSeq = 0;
const items = [];
let ticketOpen = true;

// Build the catalog: collapsed category accordions holding tap-to-add tiles.
const catRoot = document.getElementById('catalog');
CATALOG.forEach(group => {
  const sec = document.createElement('section'); sec.className = 'cat collapsed';
  const h = document.createElement('h2');
  h.innerHTML = `<span class="hleft"><span class="chev">▾</span><span>${group.cat}</span></span><span class="catnote">${group.note || ''}</span>`;
  h.addEventListener('click', () => sec.classList.toggle('collapsed'));
  sec.appendChild(h);
  const grid = document.createElement('div'); grid.className = 'grid';
  group.items.forEach(([name, unit, price, note]) => {
    const id = 'i' + (idSeq++);
    items.push({ id, name, unit, price, note: note || '', cat: group.cat, catNote: group.note || '' });
    const tile = document.createElement('button');
    tile.type = 'button'; tile.className = 'tile'; tile.dataset.id = id;
    tile.innerHTML = `
      <span class="badge" id="b-${id}"></span>
      <span class="tname">${name}</span>
      ${note ? `<span class="tnote">${note}</span>` : ''}
      <span class="tprice"><b>${fmt(price)}</b> ${unit}</span>`;
    grid.appendChild(tile);
  });
  sec.appendChild(grid);
  catRoot.appendChild(sec);
});

// Tap a tile → +1 on the ticket.
catRoot.addEventListener('click', e => {
  const tile = e.target.closest('.tile');
  if (!tile) return;
  const id = tile.dataset.id;
  qty[id] = (qty[id] || 0) + 1;
  renderTicket();
  recalc();
});

function currentLines() {
  return items.filter(it => (qty[it.id] || 0) > 0)
    .map(it => ({ ...it, q: qty[it.id], total: qty[it.id] * it.price }));
}

// Ticket drawer: quantities are adjusted here, POS-style.
const ticketEl = document.getElementById('ticket');

function renderTicket() {
  const lines = currentLines();
  ticketEl.innerHTML = lines.map(l => `
    <div class="tline">
      <div class="ti">
        <div class="n">${l.name}</div>
        <div class="u">${fmt(l.price)} ${l.unit}</div>
      </div>
      <div class="qc">
        <button type="button" aria-label="decrease" data-id="${l.id}" data-d="-1">−</button>
        <input type="number" min="0" step="1" inputmode="numeric" data-id="${l.id}" value="${l.q}">
        <button type="button" aria-label="increase" data-id="${l.id}" data-d="1">+</button>
      </div>
      <div class="lamt" id="la-${l.id}">${fmt(l.total)}</div>
    </div>`).join('');
  ticketEl.style.display = (lines.length && ticketOpen) ? '' : 'none';
}

ticketEl.addEventListener('click', e => {
  const b = e.target.closest('button[data-id]');
  if (!b) return;
  const id = b.dataset.id, d = parseInt(b.dataset.d, 10);
  qty[id] = Math.max(0, (qty[id] || 0) + d);
  renderTicket();
  recalc();
});
// Typing a qty directly: patch in place so the input keeps focus…
ticketEl.addEventListener('input', e => {
  if (!e.target.matches('input[data-id]')) return;
  const id = e.target.dataset.id;
  qty[id] = Math.max(0, parseFloat(e.target.value) || 0);
  const it = items.find(x => x.id === id);
  const la = document.getElementById('la-' + id);
  if (la) la.textContent = fmt((qty[id] || 0) * it.price);
  recalc();
});
// …then rebuild on blur so zeroed lines drop off.
ticketEl.addEventListener('change', () => { renderTicket(); recalc(); });

// Tap the summary row to show/hide the ticket.
document.getElementById('sumRow').addEventListener('click', () => {
  ticketOpen = !ticketOpen;
  renderTicket();
  recalc();
});

['member','addon','days'].forEach(id => document.getElementById(id).addEventListener('input', recalc));

function recalc() {
  const lines = currentLines();
  let sub = 0;
  items.forEach(it => {
    const q = qty[it.id] || 0;
    sub += q * it.price;
    const badge = document.getElementById('b-' + it.id);
    badge.textContent = q > 0 ? q : '';
    badge.closest('.tile').classList.toggle('on', q > 0);
  });

  const member = document.getElementById('member').checked;
  const addon = document.getElementById('addon').checked;
  const memberOff = member ? sub * 0.10 : 0;
  let total = sub - memberOff;

  const minRow = document.getElementById('minRow');
  const applyMin = !addon && !member && total > 0 && total < 750;
  minRow.style.display = applyMin ? 'flex' : 'none';
  if (applyMin) total = 750;

  document.getElementById('subtotal').textContent = lines.length ? fmt(sub) : '';
  document.getElementById('lineCount').textContent = lines.length
    ? `${ticketOpen ? '▾' : '▸'} ${lines.length} line item${lines.length > 1 ? 's' : ''} — subtotal`
    : 'No items yet — tap an item to build the quote';
  const mr = document.getElementById('memberRow');
  mr.style.display = member && sub > 0 ? 'flex' : 'none';
  document.getElementById('memberAmt').textContent = '−' + fmt(memberOff);
  document.getElementById('total').textContent = fmt(total);

  const depRow = document.getElementById('depositRow');
  if (total >= 10000) {
    depRow.style.display = 'flex';
    document.getElementById('depositLabel').textContent = 'Commercial >$10k — collect 25% deposit + progress billing';
    document.getElementById('depositAmt').textContent = fmt(total * 0.25);
  } else if (total >= 2500) {
    depRow.style.display = 'flex';
    document.getElementById('depositLabel').textContent = 'Collect 30% deposit to schedule';
    document.getElementById('depositAmt').textContent = fmt(total * 0.30);
  } else depRow.style.display = 'none';

  const flags = document.getElementById('flags');
  flags.innerHTML = '';
  const days = parseFloat(document.getElementById('days').value) || 0;
  if (days > 0 && total > 0) {
    const perDay = total / days;
    let cls = 'good', msg = `✓ ${fmt(perDay)}/crew-day — clears the $3,500 floor`;
    if (perDay < 3000) { cls = 'bad'; msg = `✗ ${fmt(perDay)}/crew-day — BELOW FLOOR. Raise price or cut scope. Owner sign-off required to send.`; }
    else if (perDay < 3500) { cls = 'warn'; msg = `⚠ ${fmt(perDay)}/crew-day — under the $3,500 target. Tighten scope or add work to the stop.`; }
    const f = document.createElement('div'); f.className = 'flag ' + cls; f.textContent = msg;
    flags.appendChild(f);
  }
  const removalLines = lines.filter(l => l.cat === 'Tree removal');
  if (removalLines.length) {
    const f = document.createElement('div'); f.className = 'flag warn';
    f.textContent = 'Removal on quote → record DBH per tree in Jobber before sending. Offer stump grinding + a replant. Discount only as plan credit.';
    flags.appendChild(f);
  }
}

// Copy quote: full descriptions — grouped by category (with its guidance note),
// each line carries unit pricing and the item's book note.
document.getElementById('copy').addEventListener('click', async () => {
  const lines = currentLines();
  if (!lines.length) return;
  const member = document.getElementById('member').checked;
  let out = 'SACRED TREE SERVICE — QUOTE ' + new Date().toLocaleDateString('en-US') + '\n';
  let lastCat = null;
  lines.forEach(l => {
    if (l.cat !== lastCat) {
      out += '\n' + l.cat.toUpperCase() + (l.catNote ? ' — ' + l.catNote : '') + '\n';
      lastCat = l.cat;
    }
    out += `• ${l.name}\n`;
    out += `  ${l.q} × ${fmt(l.price)} ${l.unit} = ${fmt(l.total)}\n`;
    if (l.note) out += `  ${l.note}\n`;
  });
  const sub = lines.reduce((a, l) => a + l.total, 0);
  out += `\nSubtotal: ${fmt(sub)}\n`;
  if (member) out += `Member rate (−10%): −${fmt(sub * 0.10)}\n`;
  if (document.getElementById('minRow').style.display !== 'none') out += 'Job minimum applied: $750\n';
  out += `TOTAL: ${document.getElementById('total').textContent}\n`;
  const dep = document.getElementById('depositRow');
  if (dep.style.display !== 'none') out += document.getElementById('depositLabel').textContent + ': ' + document.getElementById('depositAmt').textContent + '\n';
  try { await navigator.clipboard.writeText(out); }
  catch (e) { /* clipboard unavailable (non-https) — button still confirms below */ }
  const btn = document.getElementById('copy');
  btn.textContent = 'Copied ✓'; setTimeout(() => btn.textContent = 'Copy quote', 1500);
});

document.getElementById('reset').addEventListener('click', () => {
  Object.keys(qty).forEach(k => qty[k] = 0);
  document.getElementById('member').checked = false;
  document.getElementById('addon').checked = false;
  document.getElementById('days').value = '';
  renderTicket();
  recalc();
});
recalc();
</script>

</body>
</html>
