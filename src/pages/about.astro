---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JobberForm from '../components/JobberForm.astro';
import { company } from '../data/company';

const trail = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
];
---

<Base
  title="About Sacred Tree Service"
  description="Professional Orlando-area tree service founded in 2023 by Alexander Satoski, ISA Tree Service Operator. ISA Certified Arborists on staff. ISA & TCIA member. Licensed and insured."
  breadcrumbs={trail}
>
  <div class="container">
    <Breadcrumbs trail={trail} />

    <header class="head">
      <h1>About Sacred Tree Service</h1>
      <p class="lede">
        Professional standards, real-world results, and the methods we
        repeat — job after job, project after project.
      </p>
    </header>

    <div class="layout">
      <article>
        <p>
          Sacred Tree Service was founded in {new Date(company.founded).getFullYear()} by{' '}
          <strong>{company.owner}</strong>, an <strong>{company.ownerTitle}</strong>,
          to bring credentialed, standards-driven tree care to Central
          Florida property owners. Too much of the tree care industry runs on
          rushed estimates, bad pruning, and crews that disappear. We do the
          opposite: every job is assessed by an ISA Certified Arborist,
          executed to ISA and ANSI standards, and documented so the next
          project gets the benefit of the last. Real-world results, repeated.
        </p>

        <h2>Credentials &amp; Memberships</h2>
        <ul class="checks">
          <li><strong>ISA Certified Arborists on staff</strong> — every removal and pruning job is assessed by a credentialed arborist on our team.</li>
          <li><strong>Operate under ISA guidelines</strong> — pruning to ANSI A300 standards, climbing and rigging to ANSI Z133.</li>
          <li>Member of the <strong>International Society of Arboriculture (ISA)</strong>.</li>
          <li>Member of the <strong>Tree Care Industry Association (TCIA)</strong>.</li>
          <li>Fully <strong>licensed and insured</strong>, with workers’ compensation.</li>
        </ul>

        <h2>Where We Work</h2>
        <p>
          We’re <strong>centrally located in Apopka, FL</strong> — well-positioned
          to serve the greater Orlando area across a 50-mile radius spanning
          Orange, Seminole, Lake, Osceola, Volusia, Brevard, and Polk counties.
          <a href="/service-area/">See all cities we serve →</a>
        </p>

        <h2>How We Work</h2>
        <ol class="steps">
          <li><strong>You reach out.</strong> Call, message, or fill out the form.</li>
          <li><strong>We come look.</strong> Free in-person estimate, usually within a few business days.</li>
          <li><strong>You get a written quote.</strong> Clear scope, fair price, no surprises.</li>
          <li><strong>The crew shows up.</strong> Job done safely, site cleaned, walkthrough at the end.</li>
        </ol>
      </article>

      <aside>
        <JobberForm context="General estimate" />
      </aside>
    </div>
  </div>
</Base>

<style>
  .head { text-align: center; max-width: 60ch; margin: 1rem auto 2rem; }
  h1 { font-size: 2.5rem; margin: 0 0 0.6rem; }
  .lede { color: var(--muted); font-size: 1.15rem; margin: 0 auto; }
  .layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  article h2 { font-size: 1.5rem; margin: 2rem 0 0.85rem; }
  .checks { list-style: none; padding: 0; }
  .checks li { padding-left: 1.5rem; position: relative; margin-bottom: 0.5rem; }
  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.6rem; }
  aside { position: sticky; top: 100px; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    aside { position: static; }
  }
</style>
