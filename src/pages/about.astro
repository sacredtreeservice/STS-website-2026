---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookingForm from '../components/BookingForm.astro';
import { company } from '../data/company';

const trail = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
];
---

<Base
  title="About Sacred Tree Service"
  description="Professional Orlando-area tree care, founded in 2023. Corporately small: fundamentals-first tree care, defined processes, repeatable results. Licensed & insured, ISA & TCIA member."
  breadcrumbs={trail}
>
  <div class="container">
    <Breadcrumbs trail={trail} />

    <header class="head">
      <h1>About Sacred Tree Service</h1>
      <p class="lede">
        Professional standards, real-world results, and the methods we
        repeat — job after job, project after project.
      </p>
    </header>

    <div class="layout">
      <article>
        <p>
          Sacred Tree Service was founded in {new Date(company.founded).getFullYear()} to
          bring professional, standards-driven tree care to Central Florida
          property owners. Too much of the tree care industry runs on rushed
          estimates, bad pruning, and crews that disappear. We do the
          opposite: every job runs through the same process — assessment,
          written scope, execution, cleanup — and gets documented so the next
          project benefits from the last. Real-world results, repeated.
        </p>

        <h2>Corporately Small</h2>
        <p>
          We describe ourselves as <strong>corporately small</strong>: a small
          company that runs like a much bigger one where it counts. The
          fundamentals of tree care — health, structure, site — are solution
          number one for every problem we're handed, and we work defined
          processes relentlessly, optimizing for efficiency and the production
          of results. Small enough that the crew knows your property; built on
          enough process that nothing depends on memory.
        </p>
        <p>
          On the team, an arborist is a role like any other — climber, crew
          lead, driver. Certified arborists on staff handle assessments,
          diagnostics, and the documentation municipalities and insurers ask
          for; the crew puts the plan into the trees.
        </p>

        <h2>Credentials &amp; Memberships</h2>
        <ul class="checks">
          <li>Fully <strong>licensed and insured</strong>, with workers’ compensation — ask for our certificate of insurance any time.</li>
          <li>Member of the <strong>International Society of Arboriculture (ISA)</strong> and the <strong>Tree Care Industry Association (TCIA)</strong>.</li>
          <li><strong>ISA Certified Arborists on staff</strong> — removals and pruning plans are assessed by a credentialed arborist before the crew goes to work.</li>
          <li><strong>National standards on every job</strong> — pruning to ANSI A300, climbing and rigging to ANSI Z133. No topping, ever.</li>
        </ul>

        <h2>Where We Work</h2>
        <p>
          We’re <strong>centrally located in Apopka, FL</strong> — well-positioned
          to serve the greater Orlando area across a 50-mile radius spanning
          Orange, Seminole, Lake, Osceola, Volusia, Brevard, and Polk counties.
          <a href="/service-area/">See all cities we serve →</a>
        </p>

        <h2>How We Work</h2>
        <ol class="steps">
          <li><strong>You reach out.</strong> Call, message, or fill out the form.</li>
          <li><strong>We come look.</strong> Free in-person estimate, usually within a few business days.</li>
          <li><strong>You get a written quote.</strong> Clear scope, fair price, no surprises.</li>
          <li><strong>The crew shows up.</strong> Job done safely, site cleaned, walkthrough at the end.</li>
        </ol>
      </article>

      <aside>
        <BookingForm context="General estimate" />
      </aside>
    </div>
  </div>
</Base>

<style>
  .head { text-align: center; max-width: 60ch; margin: 1rem auto 2rem; }
  h1 { font-size: 2.5rem; margin: 0 0 0.6rem; }
  .lede { color: var(--muted); font-size: 1.15rem; margin: 0 auto; }
  .layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  article h2 { font-size: 1.5rem; margin: 2rem 0 0.85rem; }
  .checks { list-style: none; padding: 0; }
  .checks li { padding-left: 1.5rem; position: relative; margin-bottom: 0.5rem; }
  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.6rem; }
  aside { position: sticky; top: 100px; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    aside { position: static; }
  }
</style>
