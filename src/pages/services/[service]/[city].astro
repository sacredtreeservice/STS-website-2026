---
import { Icon } from 'astro-icon/components';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BookingForm from '../../../components/BookingForm.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import { matrixServices } from '../../../data/services';
import { matrixCities, SERVICE_AREA_UPDATED } from '../../../data/cities';
import { getCountyByName } from '../../../data/counties';
import { serviceSchema, faqSchema, webPageSchema } from '../../../lib/schema';

// Only tier-1 services × tier-1 places get a page here. The tiering comes
// from nine months of real quote data (docs/service-area-data-2026-09.md):
// six services are ~99% of revenue, and 22 places are where the work is.
// Every other service/city combination 308s to the parent service page
// (vercel.json), so the site stops publishing hundreds of near-identical
// doorway pages.
export async function getStaticPaths() {
  const out = [];
  for (const s of matrixServices) {
    for (const c of matrixCities) {
      out.push({
        params: { service: s.slug, city: c.slug },
        props: { service: s, city: c },
      });
    }
  }
  return out;
}

const { service, city } = Astro.props;

const isHood = Boolean(city.neighborhoodOf);
// "Dr. Phillips, a neighborhood of Orlando, FL" / "Sanford, FL"
const placeLine = isHood ? `${city.name}, a neighborhood of ${city.neighborhoodOf}, FL` : `${city.name}, FL`;
// Short form for titles/H1: "Dr. Phillips, Orlando" / "Sanford, FL"
const placeShort = isHood ? `${city.name}, ${city.neighborhoodOf}` : `${city.name}, FL`;
const areaLine = isHood ? `${city.name} and the surrounding ${city.neighborhoodOf} area` : `${city.name} and ${city.county} County`;

const url = `/services/${service.slug}/${city.slug}/`;
const trail = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: service.name, url: `/services/${service.slug}/` },
  { name: city.name, url },
];

// Two place-specific answers plus the first two real service FAQs (the ones
// with price ranges and timing) — so the page answers the questions people
// actually ask about this service here, not three boilerplate ones.
const placeFaqs = [
  { q: `Do you provide ${service.name.toLowerCase()} in ${city.name}?`,
    a: `Yes. Sacred Tree Service serves ${areaLine} for ${service.name.toLowerCase()}. We're based in Apopka, FL — about ${city.miles} miles from ${city.name}, well inside our 50-mile service radius.` },
  { q: `How quickly can you respond in ${city.name}?`,
    a: `Most ${city.name} estimates are scheduled within 1–3 business days. Storm damage and emergency calls are prioritized — we’ll do our best to get a crew out the same day during active storm response.` },
];
const faqs = [...placeFaqs, ...(service.faqs ?? []).slice(0, 2)];

const localHook = city.hook ?? `Property owners in ${city.name} rely on us for safe, professional tree care across ${city.county} County.`;

// Answer-shaped opener: a self-contained, liftable direct answer to the
// question this page exists for — before any supporting context. This is
// the sentence an AI assistant or a featured snippet quotes.
const directAnswer = `Yes — Sacred Tree Service provides ${service.name.toLowerCase()} in ${placeLine}. We work ${city.name} from our Apopka, FL base, about ${city.miles} miles away and well inside our 50-mile service radius. Licensed, insured, workers’ comp, ISA Certified Arborists on staff, and free in-person estimates usually scheduled within 1–3 business days. Call (321) 204-8459.`;

const county = getCountyByName(city.county);
// The other core services available on their own page in this place.
const otherServices = matrixServices.filter((s) => s.slug !== service.slug);

const title = `${service.name} in ${placeShort}`;
const description = `${service.name} in ${placeShort} — licensed & insured, ISA Certified Arborists on staff, free in-person estimates.`;

const jsonLd = [
  serviceSchema({
    name: service.name,
    description: service.description,
    slug: service.slug,
    city: city.name,
    citySlug: city.slug,
    neighborhoodOf: city.neighborhoodOf,
  }),
  faqSchema(faqs),
  webPageSchema({ url, name: title, description, dateModified: SERVICE_AREA_UPDATED }),
];

const updated = new Date(`${SERVICE_AREA_UPDATED}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={title} description={description} breadcrumbs={trail} jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs trail={trail} />

    <header class="head">
      <h1>{service.name} in {placeShort}</h1>
      <p class="lede">{service.blurb}</p>
    </header>

    <div class="layout">
      <article>
        <p class="answer"><strong>{directAnswer}</strong></p>
        <p class="hook">{localHook} Our crew handles each job from in-person estimate through cleanup — one process, fully licensed and insured.</p>

        <h2>About {service.name.toLowerCase()} in {city.name}</h2>
        <p>{service.description}</p>

        {city.intro && (
          <>
            <h2>Tree care in {city.name}</h2>
            <p>{city.intro}</p>
            {city.species && city.species.length > 0 && (
              <p class="meta-line"><strong>Common trees &amp; palms here:</strong> {city.species.join(', ')}.</p>
            )}
            {city.landmarks && city.landmarks.length > 0 && (
              <p class="meta-line"><strong>Areas we cover around {city.name}:</strong> {city.landmarks.join(', ')}.</p>
            )}
          </>
        )}

        <h2>Serving {city.name} and nearby</h2>
        <p>
          {isHood ? (
            <>
              {city.name} is a neighborhood of {city.neighborhoodOf}{city.zip ? ` (ZIP ${city.zip})` : ''}, and one of the
              parts of the city where we work most. We're based in Apopka, FL — roughly {city.miles} miles away — and cover
              all of <a href="/service-area/orlando/">Orlando</a> and {county ? <a href={`/service-area/${county.slug}/`}>{county.name}</a> : `${city.county} County`} within
              our 50-mile service radius.
            </>
          ) : (
            <>
              Sacred Tree Service is based in Apopka, FL — roughly {city.miles} miles from {city.name} — and works across{' '}
              {county ? <a href={`/service-area/${county.slug}/`}>{county.name}</a> : `${city.county} County`} and the broader
              Central Florida region within a 50-mile service radius.
            </>
          )}
        </p>

        <h2>What to expect</h2>
        <ol class="steps">
          <li><strong>Free estimate.</strong> Call or request a visit; we walk the job with you on-site.</li>
          <li><strong>Written quote.</strong> Clear scope, no surprises, no hidden fees.</li>
          <li><strong>Schedule the work.</strong> Most jobs are scheduled within 1–2 weeks; emergencies sooner.</li>
          <li><strong>Crew arrives.</strong> We complete the work, clean up, and walk through the finished site.</li>
        </ol>

        <FaqBlock faqs={faqs} />

        <nav class="related" aria-label={`More tree services in ${city.name}`}>
          <h2>More tree services in {city.name}</h2>
          <ul>
            {otherServices.map((s) => (
              <li>
                <a href={`/services/${s.slug}/${city.slug}/`}>
                  <Icon name={s.icon} aria-hidden="true" />
                  <span>{s.shortName} in {city.name}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="related-foot">
            See <a href={`/service-area/${city.slug}/`}>all tree services in {city.name}</a>{isHood && <>, our <a href="/service-area/orlando/">Orlando</a> page</>}{county && <>, and our <a href={`/service-area/${county.slug}/`}>{county.name}</a> service area</>}.
          </p>
        </nav>

        <p class="updated">Page updated {updated}.</p>
      </article>

      <aside>
        <BookingForm
          heading={`Free ${service.shortName} Estimate in ${city.name}`}
          context={`${service.name} — ${placeShort}`}
        />
      </aside>
    </div>
  </div>
</Base>

<style>
  .head { text-align: center; max-width: 65ch; margin: 1rem auto 2rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0 0 0.6rem; }
  .lede { color: var(--muted); font-size: 1.1rem; margin: 0 auto; }
  .answer {
    background: var(--surface);
    border-left: 4px solid var(--green);
    padding: 1rem 1.25rem;
    margin: 0 0 2rem;
    border-radius: 4px;
  }
  .hook { margin: 0 0 2rem; color: var(--ink-soft); }
  .layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  article h2 { font-size: 1.5rem; margin: 2rem 0 0.85rem; }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.6rem; }
  .meta-line {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0.5rem 0;
  }
  .meta-line strong { color: var(--green-dark); }
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .related h2 { font-size: 1.3rem; margin: 0 0 1rem; }
  .related ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .related ul a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--green-dark);
    font-size: 0.92rem;
    transition: all 0.2s var(--easing);
  }
  .related ul a:hover { border-color: var(--border-strong); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .related ul [data-icon] { width: 16px; height: 16px; opacity: 0.7; flex-shrink: 0; }
  .related-foot { font-size: 0.92rem; color: var(--muted); margin: 0; }
  .updated { margin-top: 2rem; font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 520px) { .related ul { grid-template-columns: 1fr; } }
  aside { position: sticky; top: 100px; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    aside { position: static; }
  }
</style>
