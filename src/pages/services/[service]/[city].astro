---
import { Icon } from 'astro-icon/components';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import JobberForm from '../../../components/JobberForm.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import { services } from '../../../data/services';
import { cities } from '../../../data/cities';
import { getCountyByName } from '../../../data/counties';
import { serviceSchema, faqSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const out = [];
  for (const s of services) {
    for (const c of cities) {
      out.push({
        params: { service: s.slug, city: c.slug },
        props: { service: s, city: c },
      });
    }
  }
  return out;
}

const { service, city } = Astro.props;

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: service.name, url: `/services/${service.slug}/` },
  { name: city.name, url: `/services/${service.slug}/${city.slug}/` },
];

const faqs = [
  { q: `Do you provide ${service.name.toLowerCase()} in ${city.name}, FL?`,
    a: `Yes. Sacred Tree Service serves ${city.name} and the surrounding ${city.county} County area for ${service.name.toLowerCase()}. We're based in Apopka, FL — centrally located to reach ${city.name} well inside our 50-mile service radius.` },
  { q: `How quickly can you respond in ${city.name}?`,
    a: `Most ${city.name} estimates are scheduled within 1–3 business days. Storm damage and emergency calls are prioritized — we’ll do our best to get a crew out the same day during active storm response.` },
  { q: 'Are you licensed and insured to work in this area?',
    a: 'Yes — Sacred Tree Service LLC is licensed, insured, and carries workers’ comp. We are members of ISA and TCIA with ISA Certified Arborists on staff.' },
];

const localHook = city.hook ?? `Property owners in ${city.name} rely on us for safe, professional tree care across ${city.county} County.`;

const county = getCountyByName(city.county);
// Cross-links: other services available in this same city, to turn each
// long-tail page into part of a real cluster instead of an orphan.
const otherServices = services.filter((s) => s.slug !== service.slug).slice(0, 6);

const jsonLd = [
  serviceSchema({ name: service.name, description: service.description, slug: service.slug, city: city.name }),
  faqSchema(faqs),
];
---

<Base
  title={`${service.name} in ${city.name}, FL`}
  description={`${service.blurb} Serving ${city.name} and ${city.county} County. ISA Certified Arborists, licensed & insured.`}
  breadcrumbs={trail}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs trail={trail} />

    <header class="head">
      <h1>{service.name} in {city.name}, FL</h1>
      <p class="lede">{service.blurb}</p>
    </header>

    <div class="layout">
      <article>
        <p class="answer">
          <strong>Yes — Sacred Tree Service provides {service.name.toLowerCase()} in {city.name}, FL.</strong>{' '}
          {localHook} Our ISA Certified Arborists handle each job from in-person
          estimate through cleanup, with full licensing and insurance.
        </p>

        <h2>About {service.name.toLowerCase()} in {city.name}</h2>
        <p>{service.description}</p>

        {city.intro && (
          <>
            <h2>Tree care in {city.name}</h2>
            <p>{city.intro}</p>
            {city.species && city.species.length > 0 && (
              <p class="meta-line"><strong>Common trees &amp; palms here:</strong> {city.species.join(', ')}.</p>
            )}
            {city.landmarks && city.landmarks.length > 0 && (
              <p class="meta-line"><strong>Areas we cover around {city.name}:</strong> {city.landmarks.join(', ')}.</p>
            )}
          </>
        )}

        <h2>Serving {city.name} and nearby</h2>
        <p>
          Sacred Tree Service is based in Apopka, FL — centrally located to
          reach {city.name} and the rest of the greater Orlando area{city.miles > 0 ? `, roughly ${city.miles} miles from our base` : ''}.
          We work across {county ? <a href={`/service-area/${county.slug}/`}>{county.name}</a> : `${city.county} County`} and the
          broader Central Florida region within a 50-mile service radius.
        </p>

        <h2>What to expect</h2>
        <ol class="steps">
          <li><strong>Free estimate.</strong> Call or request a visit; we walk the job with you on-site.</li>
          <li><strong>Written quote.</strong> Clear scope, no surprises, no hidden fees.</li>
          <li><strong>Schedule the work.</strong> Most jobs are scheduled within 1–2 weeks; emergencies sooner.</li>
          <li><strong>Crew arrives.</strong> We complete the work, clean up, and walk through the finished site.</li>
        </ol>

        <FaqBlock faqs={faqs} />

        <nav class="related" aria-label={`More tree services in ${city.name}`}>
          <h2>More tree services in {city.name}</h2>
          <ul>
            {otherServices.map((s) => (
              <li>
                <a href={`/services/${s.slug}/${city.slug}/`}>
                  <Icon name={s.icon} aria-hidden="true" />
                  <span>{s.shortName} in {city.name}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="related-foot">
            See <a href={`/service-area/${city.slug}/`}>all tree services in {city.name}</a>{county && <>, part of our <a href={`/service-area/${county.slug}/`}>{county.name}</a> service area</>}.
          </p>
        </nav>
      </article>

      <aside>
        <JobberForm
          heading={`Free ${service.shortName} Estimate in ${city.name}`}
          context={`${service.name} — ${city.name}, FL`}
        />
      </aside>
    </div>
  </div>
</Base>

<style>
  .head { text-align: center; max-width: 65ch; margin: 1rem auto 2rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0 0 0.6rem; }
  .lede { color: var(--muted); font-size: 1.1rem; margin: 0 auto; }
  .answer {
    background: var(--surface);
    border-left: 4px solid var(--green);
    padding: 1rem 1.25rem;
    margin: 0 0 2rem;
    border-radius: 4px;
  }
  .layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  article h2 { font-size: 1.5rem; margin: 2rem 0 0.85rem; }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.6rem; }
  .meta-line {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0.5rem 0;
  }
  .meta-line strong { color: var(--green-dark); }
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .related h2 { font-size: 1.3rem; margin: 0 0 1rem; }
  .related ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .related ul a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--green-dark);
    font-size: 0.92rem;
    transition: all 0.2s var(--easing);
  }
  .related ul a:hover { border-color: var(--border-strong); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .related ul [data-icon] { width: 16px; height: 16px; opacity: 0.7; flex-shrink: 0; }
  .related-foot { font-size: 0.92rem; color: var(--muted); margin: 0; }
  @media (max-width: 520px) { .related ul { grid-template-columns: 1fr; } }
  aside { position: sticky; top: 100px; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    aside { position: static; }
  }
</style>
