---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { services } from '../../data/services';

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
];
---

<Base
  title="Tree Care Services in Central Florida"
  description="Full-service tree care from ISA Certified Arborists: removal, pruning, stump grinding, palm care, emergency response, land clearing, and more."
  breadcrumbs={trail}
>
  <div class="container">
    <Breadcrumbs trail={trail} />
    <h1>Our Tree Care Services</h1>
    <p class="lede">
      Every tree on your property is different — and so is the right approach.
      Our ISA Certified Arborists assess each job individually, recommend the
      right scope, and execute with the equipment and expertise to do it
      safely.
    </p>

    <ul class="svc-grid">
      {services.map((s) => (
        <li>
          <a href={`/services/${s.slug}/`}>
            <span class="icon" aria-hidden="true">{s.icon}</span>
            <h2>{s.name}</h2>
            <p>{s.blurb}</p>
            <span class="more">Learn more →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  h1 { font-size: 2.5rem; margin: 0 0 0.75rem; }
  .lede { color: var(--muted); max-width: 70ch; font-size: 1.1rem; margin-bottom: 2.5rem; }
  .svc-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .svc-grid a {
    display: block;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    height: 100%;
  }
  .svc-grid a:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(0,0,0,0.07);
    border-color: rgba(75, 112, 33, 0.35);
  }
  .icon { font-size: 2rem; }
  .svc-grid h2 { font-size: 1.25rem; margin: 0.6rem 0 0.4rem; }
  .svc-grid p { color: var(--muted); margin: 0 0 0.85rem; font-size: 0.95rem; }
  .more { color: var(--green); font-weight: 700; font-size: 0.9rem; }
</style>
