---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookingForm from '../../components/BookingForm.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { services } from '../../data/services';
import { cities } from '../../data/cities';
import { serviceSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  // Services with a hand-built page under src/pages/services/<slug>.astro are
  // skipped here — otherwise Astro emits a "route collision" warning for each.
  // (Declared inside: getStaticPaths runs in isolation and can't see module-scope consts.)
  const CUSTOM_PAGES = new Set(['tree-planting', 'tree-care-plans', 'plant-health-care', 'large-tree-transplanting']);
  return services
    .filter((s) => !CUSTOM_PAGES.has(s.slug))
    .map((s) => ({ params: { service: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: service.name, url: `/services/${service.slug}/` },
];

const defaultFaqs = [
  { q: `How much does ${service.name.toLowerCase()} cost in Central Florida?`,
    a: 'Pricing depends on tree size, access, location relative to structures, and disposal needs. We provide free in-person estimates so the quote reflects the actual job, not a generic ballpark.' },
  { q: `Do you offer free estimates for ${service.name.toLowerCase()}?`,
    a: 'Yes. We come to the property, walk the job with you, and provide a written estimate at no cost.' },
  { q: 'Are you licensed and insured?',
    a: 'Yes — Sacred Tree Service LLC is licensed, insured, and carries workers’ compensation, and we’re members of the ISA and TCIA. Ask for our certificate of insurance any time.' },
];
const faqs = service.faqs ?? defaultFaqs;

// Every city, grouped by county — service hubs are the natural place to give
// all 44 combo pages a crawl path (previously only the first 18 got links).
const countyNames = [...new Set(cities.map((c) => c.county))];
const citiesByCounty = countyNames.map((county) => ({
  county,
  cities: cities.filter((c) => c.county === county),
}));

// Curated "pairs with" cross-links (falls back to adjacent services).
const related = (service.relatedSlugs ?? [])
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is (typeof services)[number] => Boolean(s));

const jsonLd = [serviceSchema({ name: service.name, description: service.description, slug: service.slug }), faqSchema(faqs)];
---

<Base
  title={`${service.name} in Orlando & Central Florida`}
  description={`${service.blurb} Professional crew, free estimates, licensed & insured.`}
  breadcrumbs={trail}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs trail={trail} />
    <header class="head">
      <span class="icon-hero" aria-hidden="true"><Icon name={service.icon} /></span>
      <h1>{service.name}</h1>
      <p class="lede">{service.blurb}</p>
    </header>

    <div class="layout">
      <article>
        <h2>What this service includes</h2>
        <p>{service.description}</p>

        <h2>Why Sacred Tree Service?</h2>
        <ul class="checks">
          <li>Fundamentals first — we diagnose the actual problem before anyone touches a saw.</li>
          <li>One process on every job: assessment, written scope, execution, cleanup.</li>
          <li>Fully licensed and insured, with workers’ comp coverage.</li>
          <li>Work to national standards (ANSI A300) as an ISA &amp; TCIA member — certified arborists on staff for assessments.</li>
        </ul>

        {related.length > 0 && (
          <>
            <h2>Pairs with</h2>
            <ul class="related">
              {related.map((r) => (
                <li>
                  <a href={`/services/${r.slug}/`}>
                    <strong>{r.name}</strong>
                    <span>{r.blurb}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}

        <h2>Cities we serve</h2>
        <p>We provide {service.shortName.toLowerCase()} services across Central Florida, including:</p>
        {citiesByCounty.map((group) => (
          <div class="county-group">
            <h3>{group.county} County</h3>
            <ul class="cities">
              {group.cities.map((c) => (
                <li><a href={`/services/${service.slug}/${c.slug}/`}>{service.shortName} in {c.name}</a></li>
              ))}
            </ul>
          </div>
        ))}

        <FaqBlock faqs={faqs} />
      </article>

      <aside>
        <BookingForm context={service.name} />
      </aside>
    </div>
  </div>
</Base>

<style>
  .head {
    text-align: center;
    margin: 1rem 0 3rem;
  }
  .icon-hero {
    display: inline-grid;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(75, 112, 33, 0.15), rgba(104, 204, 209, 0.12));
    color: var(--green-dark);
    margin-bottom: 1rem;
  }
  .icon-hero [data-icon] { width: 40px; height: 40px; }
  h1 { font-size: 2.5rem; margin: 0.5rem 0 0.75rem; }
  .lede { color: var(--muted); max-width: 65ch; margin: 0 auto; font-size: 1.15rem; }
  .layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  article h2 {
    font-size: 1.5rem;
    margin: 2rem 0 0.85rem;
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .checks li {
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
  }
  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .related {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .related a {
    display: block;
    padding: 0.85rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s ease, transform 0.2s var(--easing), box-shadow 0.2s ease;
  }
  .related a:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .related strong { display: block; color: var(--green-dark); margin-bottom: 0.15rem; }
  .related span { color: var(--muted); font-size: 0.9rem; }
  .county-group h3 {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.5rem;
    color: var(--green-dark);
  }
  .cities {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    gap: 1rem;
  }
  .cities li { margin-bottom: 0.4rem; }
  .cities a {
    color: var(--green-dark);
    text-decoration: none;
  }
  .cities a:hover { text-decoration: underline; }
  aside {
    position: sticky;
    top: 100px;
  }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    aside { position: static; }
    .cities { columns: 1; }
  }
</style>
