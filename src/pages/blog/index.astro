---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
];

// Sanity wiring goes here. Until then, this is a clean stub so the route
// exists, the nav works, and SEO indexing won't 404 on /blog/.
const posts: { slug: string; title: string; excerpt: string; published: string }[] = [];
---

<Base
  title="Blog — Central Florida Tree Care Notes"
  description="Notes from the field on Florida tree care, storm prep, species ID, and what we’re learning on the job."
  breadcrumbs={trail}
>
  <div class="container">
    <Breadcrumbs trail={trail} />
    <h1>Notes from the Field</h1>
    <p class="lede">
      Stories, tree ID, storm lessons, and what we’re seeing across Central
      Florida — from the people climbing the trees.
    </p>

    {posts.length === 0 ? (
      <div class="empty">
        <p><strong>The blog is being wired up.</strong></p>
        <p>
          Posts will live in <strong>Sanity</strong> and pull into this page
          automatically. Configure your Sanity project, add the env vars, and
          drop posts will show up here without code changes.
        </p>
        <p class="setup">
          <em>Setup pending — see <code>SANITY_SETUP.md</code> in the repo.</em>
        </p>
      </div>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.slug}/`}>
              <h2>{p.title}</h2>
              <p>{p.excerpt}</p>
              <time>{p.published}</time>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  h1 { font-size: 2.5rem; margin: 0 0 0.75rem; }
  .lede { color: var(--muted); max-width: 70ch; font-size: 1.1rem; margin-bottom: 2.5rem; }
  .empty {
    background: #fff8e6;
    border: 1px dashed #d4b15a;
    padding: 1.5rem;
    border-radius: 12px;
    color: #6b5418;
  }
  .empty code {
    background: rgba(0,0,0,0.05);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
  }
  .setup { margin-top: 0.6rem; }
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  .posts a {
    display: block;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .posts h2 { font-size: 1.3rem; margin: 0 0 0.4rem; }
  .posts p { color: var(--muted); margin: 0 0 0.5rem; }
  .posts time { color: var(--muted); font-size: 0.85rem; }
</style>
