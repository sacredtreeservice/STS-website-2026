---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
];

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Field Notes — Florida Tree Care Blog"
  description="Notes from the field on Florida tree care, storm prep, species ID, and what we’re learning on the job — written by ISA Certified Arborists."
  breadcrumbs={trail}
>
  <div class="container">
    <Breadcrumbs trail={trail} />
    <header class="head" data-reveal>
      <span class="kicker">Field Notes</span>
      <h1>Notes from the field</h1>
      <p class="lede">
        Stories, tree ID, storm lessons, and what we’re seeing across Central
        Florida — from the people climbing the trees.
      </p>
    </header>

    {posts.length === 0 ? (
      <div class="empty">
        <p><strong>No posts yet.</strong></p>
        <p>Drop a new <code>.md</code> file in <code>src/content/blog/</code> and it'll show up here.</p>
      </div>
    ) : (
      <ul class="posts" data-reveal data-reveal-stagger>
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              {p.data.coverImage && (
                <div class="img">
                  <img src={p.data.coverImage.src} alt={p.data.coverAlt ?? p.data.title} loading="lazy" />
                </div>
              )}
              <div class="meta">
                {p.data.categories.length > 0 && (
                  <span class="cat">{p.data.categories.join(' · ')}</span>
                )}
                <h2>{p.data.title}</h2>
                <p>{p.data.excerpt}</p>
                <footer>
                  <span class="byline">
                    {p.data.author}{p.data.isaCertified && (
                      <span class="badge"><Icon name="lucide:badge-check" /> ISA Certified</span>
                    )}
                  </span>
                  <time>{fmt(p.data.publishedAt)}</time>
                </footer>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .head { text-align: center; margin: 2rem 0 3rem; }
  .kicker {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  h1 { font-size: clamp(2.2rem, 5vw, 3rem); margin: 0 0 0.6rem; }
  .lede { color: var(--muted); max-width: 60ch; font-size: 1.1rem; margin: 0 auto; }
  .empty {
    background: #fff8e6;
    border: 1px dashed #d4b15a;
    padding: 1.5rem;
    border-radius: 12px;
    color: #6b5418;
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: 0 0 5rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  .posts a {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 16px;
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    transition: transform 0.2s var(--easing), box-shadow 0.25s ease;
    height: 100%;
  }
  .posts a:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .posts .img { aspect-ratio: 16/9; overflow: hidden; }
  .posts .img img { width: 100%; height: 100%; object-fit: cover; }
  .meta { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }
  .cat { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--green); font-weight: 700; }
  .posts h2 { font-size: 1.3rem; margin: 0.4rem 0 0.5rem; }
  .posts p { color: var(--muted); margin: 0 0 1rem; flex: 1; }
  .meta footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--muted);
    border-top: 1px solid rgba(0,0,0,0.06);
    padding-top: 0.85rem;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .byline { display: inline-flex; align-items: center; gap: 0.5rem; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: rgba(75, 112, 33, 0.12);
    color: var(--green-dark);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .badge [data-icon] { width: 12px; height: 12px; }
</style>
