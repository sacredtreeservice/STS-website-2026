---
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { articleSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.data.title, url: `/blog/${post.id}/` },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = articleSchema({
  title: post.data.title,
  description: post.data.seoDescription ?? post.data.excerpt,
  url: `/blog/${post.id}/`,
  published: post.data.publishedAt.toISOString(),
  modified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: post.data.author,
});
---

<Base
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.excerpt}
  ogImage={post.data.ogImage ?? post.data.coverImage?.src}
  breadcrumbs={trail}
  jsonLd={jsonLd}
>
  <article class="post">
    <div class="container narrow-post">
      <Breadcrumbs trail={trail} />

      <header data-reveal>
        {post.data.categories.length > 0 && (
          <p class="cats">{post.data.categories.join(' · ')}</p>
        )}
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.excerpt}</p>
        <div class="byline">
          <div class="who">
            <strong>{post.data.author}</strong>
            {post.data.authorRole && <em>{post.data.authorRole}</em>}
          </div>
          {post.data.isaCertified && (
            <span class="badge"><Icon name="lucide:badge-check" /> ISA Certified Arborist</span>
          )}
          <time>{fmt(post.data.publishedAt)}</time>
        </div>
      </header>

      {post.data.coverImage && (
        <img class="hero" src={post.data.coverImage.src} alt={post.data.coverAlt ?? post.data.title} />
      )}

      <div class="body">
        <Content />
      </div>

      <nav class="post-nav">
        <a href="/blog/" class="back">
          <Icon name="lucide:arrow-left" /> All posts
        </a>
      </nav>
    </div>
  </article>

  <CtaBand
    heading="Have a tree question we should write about?"
    subheading="Tell us what you'd want to know — we use real reader questions to plan posts."
  />
</Base>

<style>
  .narrow-post { max-width: 760px; }
  .post header { margin: 1.5rem 0 2rem; }
  .cats { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--green); font-weight: 700; margin: 0; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.4rem 0 0.6rem; }
  .lede { color: var(--muted); font-size: 1.2rem; margin: 0 0 1.25rem; }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem; color: var(--muted); font-size: 0.9rem; padding-top: 1rem; border-top: 1px solid rgba(0,0,0,0.06); }
  .who strong { display: block; color: var(--ink); font-weight: 700; }
  .who em { font-style: normal; font-size: 0.85rem; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(75, 112, 33, 0.12);
    color: var(--green-dark);
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .badge [data-icon] { width: 13px; height: 13px; }
  .hero { width: 100%; border-radius: 14px; margin: 1rem 0 2.5rem; box-shadow: var(--shadow-md); }
  .body { font-size: 1.1rem; line-height: 1.75; color: var(--ink-soft); }
  .body :global(h2) { font-size: 1.65rem; margin: 2.5rem 0 0.85rem; color: var(--green-dark); }
  .body :global(h3) { font-size: 1.25rem; margin: 2rem 0 0.6rem; }
  .body :global(p) { margin: 0 0 1.2rem; }
  .body :global(ul), .body :global(ol) { margin: 0 0 1.2rem 1.4rem; }
  .body :global(li) { margin-bottom: 0.4rem; }
  .body :global(strong) { color: var(--ink); }
  .body :global(blockquote) { border-left: 3px solid var(--green); margin: 1.5rem 0; padding: 0.5rem 1.25rem; color: var(--muted); font-style: italic; background: rgba(75, 112, 33, 0.04); border-radius: 0 8px 8px 0; }
  .body :global(a) { color: var(--green-dark); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
  .body :global(code) { background: rgba(0,0,0,0.05); padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
  .body :global(hr) { border: 0; border-top: 1px solid rgba(0,0,0,0.1); margin: 2rem 0; }
  .post-nav { margin: 3rem 0; padding-top: 2rem; border-top: 1px solid rgba(0,0,0,0.08); }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--green-dark);
    font-weight: 700;
    text-decoration: none;
  }
  .back [data-icon] { width: 16px; height: 16px; transition: transform 0.2s var(--easing); }
  .back:hover [data-icon] { transform: translateX(-3px); }
</style>
