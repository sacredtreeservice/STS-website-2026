---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import JobberForm from '../components/JobberForm.astro';
import QuickActions from '../components/QuickActions.astro';
import TrustStrip from '../components/TrustStrip.astro';
import WhyUs from '../components/WhyUs.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import LatestPosts from '../components/LatestPosts.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { cities } from '../data/cities';
import { company } from '../data/company';

const featuredServices = services.slice(0, 6);
const cityShortlist = cities.slice(0, 12);
---

<Base
  title="Tree Care, Pruning & Plant Health in Orlando"
  description="ISA Certified Arborists in Orlando. Proactive tree care, pruning, plant health, and thoughtful removals across Central Florida. Family-owned, licensed & insured."
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-inner">
      <span class="eyebrow" data-reveal>
        <span class="dot"></span>
        Family-owned · Orlando, FL · Since 2023
      </span>

      <h1 data-reveal>
        Tree care for the trees that
        <span class="ink">shape your world.</span>
      </h1>

      <p class="lede" data-reveal>
        Proactive pruning, plant health, and thoughtful work when it’s
        time — by ISA Certified Arborists who’d rather save your tree
        than sell you a removal.
      </p>

      <div class="cta" data-reveal>
        <a class="btn primary large" href="/contact/">
          <Icon name="lucide:clipboard-check" /> Free Estimate
        </a>
        <a class="btn ghost large" href={company.phoneHref}>
          <Icon name="lucide:phone" /> {company.phone}
        </a>
      </div>

      <div class="hero-meta" data-reveal>
        <span><Icon name="lucide:badge-check" /> ISA Certified Arborists</span>
        <span class="dot-sep" aria-hidden="true">·</span>
        <span><Icon name="lucide:shield" /> Fully Insured</span>
        <span class="dot-sep" aria-hidden="true">·</span>
        <span><Icon name="lucide:landmark" /> ISA & TCIA Member</span>
      </div>
    </div>

    <a class="scroll-cue" href="#what-we-do" aria-label="Scroll down">
      <Icon name="lucide:chevron-down" />
    </a>
  </section>

  <TrustStrip />

  <QuickActions />

  <section id="what-we-do" class="container svc-section">
    <header class="section-head" data-reveal>
      <span class="kicker">What we do</span>
      <h2>Care for every stage of a tree's life</h2>
      <p>From routine pruning and plant health, through removals and replanting — all under one crew.</p>
    </header>
    <div class="cards" data-reveal data-reveal-stagger>
      {featuredServices.map((s) => (
        <a class="card" href={`/services/${s.slug}/`}>
          <span class="ico"><Icon name={s.icon} /></span>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
          <span class="more">Learn more <Icon name="lucide:arrow-right" /></span>
        </a>
      ))}
    </div>
    <div class="more-link">
      <a class="btn ghost" href="/services/">All services <Icon name="lucide:arrow-right" /></a>
    </div>
  </section>

  <WhyUs />

  <Process />

  <Testimonials />

  <Gallery />

  <LatestPosts />

  <section class="container area-section">
    <div class="area-grid">
      <div class="area-text" data-reveal>
        <span class="kicker">Service area</span>
        <h2>50 miles around Orlando</h2>
        <p>
          We work across <strong>Orange, Seminole, Lake, Osceola, Volusia,
          Brevard, and Polk</strong> counties. Same crew, same standards, no
          out-of-area surcharges.
        </p>
        <a class="btn ghost" href="/service-area/">
          <Icon name="lucide:map" /> See all cities
        </a>
      </div>
      <ul class="cloud" data-reveal data-reveal-stagger>
        {cityShortlist.map((c) => (
          <li><a href={`/service-area/${c.slug}/`}>{c.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />

  <section class="container narrow form-block">
    <JobberForm context="General estimate" />
  </section>
</Base>

<style>
  .hero {
    position: relative;
    color: #fff;
    padding: 7rem 1.25rem 6rem;
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(560px, 76vh, 760px);
    display: flex;
    align-items: center;
  }
  .hero-bg {
    position: absolute;
    inset: -8%;
    background:
      linear-gradient(180deg, rgba(20, 30, 15, 0.45) 0%, rgba(20, 30, 15, 0.7) 60%, rgba(20, 30, 15, 0.92) 100%),
      url('/assets/hero.jpg') center/cover no-repeat;
    z-index: -2;
    animation: heroFloat 22s ease-in-out infinite alternate;
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 50% 0%, transparent 0%, rgba(0,0,0,0.0) 40%, rgba(8, 14, 12, 0.45) 100%);
    pointer-events: none;
  }
  @keyframes heroFloat {
    from { transform: scale(1.04) translate(0, 0); }
    to   { transform: scale(1.08) translate(-1.5%, -1%); }
  }
  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.18);
    color: #e8efe0;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 1.75rem;
    text-transform: uppercase;
  }
  .eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #b9d093;
    box-shadow: 0 0 0 4px rgba(185, 208, 147, 0.18);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .hero h1 .ink {
    background: linear-gradient(110deg, #b9d093 0%, #a6dbbe 50%, #6dcaa3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
  }
  .lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: #d8e1d3;
    margin: 0 auto 2rem;
    max-width: 60ch;
    line-height: 1.55;
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .hero .btn.primary { background: #ffffff; color: #1a2110; }
  .hero .btn.primary:hover { background: #f3f1eb; color: #1a2110; }
  .hero .btn.ghost {
    color: #fff;
    border-color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .hero .btn.ghost:hover { background: rgba(255,255,255,0.12); border-color: #fff; }

  .hero-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1rem;
    color: rgba(255,255,255,0.78);
    font-size: 0.85rem;
  }
  .hero-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-meta [data-icon] { width: 14px; height: 14px; color: #b9d093; }
  .dot-sep { opacity: 0.4; }
  @media (max-width: 600px) {
    .dot-sep { display: none; }
  }

  .scroll-cue {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.25);
    display: grid;
    place-items: center;
    animation: bounce 2.5s ease-in-out infinite;
    transition: all 0.2s var(--easing);
  }
  .scroll-cue:hover { background: rgba(255,255,255,0.12); color: #fff; }
  .scroll-cue [data-icon] { width: 18px; height: 18px; }
  @keyframes bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }

  .svc-section { padding: 5rem 1.25rem; }
  .section-head { text-align: center; margin: 0 auto 2.5rem; max-width: 60ch; }
  .kicker {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  .section-head h2 { font-size: clamp(1.8rem, 3.6vw, 2.4rem); margin: 0 0 0.4rem; }
  .section-head p { color: var(--muted); margin: 0; }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.85rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.25s var(--easing), box-shadow 0.3s ease, border-color 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 60%, rgba(75, 112, 33, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .card:hover::before { opacity: 1; }
  .card .ico {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--green-tint), color-mix(in srgb, var(--teal) 18%, transparent));
    color: var(--green-dark);
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
  }
  .card .ico [data-icon] { width: 28px; height: 28px; }
  .card h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }
  .card p { color: var(--muted); margin: 0 0 1rem; font-size: 0.95rem; }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--green);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .more [data-icon] { width: 16px; height: 16px; transition: transform 0.2s var(--easing); }
  .card:hover .more [data-icon] { transform: translateX(3px); }
  .more-link { text-align: center; margin-top: 2rem; }
  .more-link .btn { display: inline-flex; gap: 0.4rem; }
  .more-link .btn [data-icon] { width: 16px; height: 16px; }

  .area-section { padding: 5rem 1.25rem; }
  .area-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    align-items: center;
  }
  .area-text h2 { font-size: clamp(1.8rem, 3.6vw, 2.4rem); margin: 0 0 1rem; }
  .area-text p { color: var(--muted); margin: 0 0 1.5rem; max-width: 40ch; }
  .area-text .btn { display: inline-flex; gap: 0.4rem; }
  .area-text .btn [data-icon] { width: 16px; height: 16px; }
  .cloud {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cloud li a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    text-decoration: none;
    color: var(--green-dark);
    background: var(--surface);
    font-size: 0.9rem;
    transition: all 0.2s var(--easing);
  }
  .cloud li a:hover {
    background: var(--green);
    color: var(--ink-strong);
    border-color: var(--green);
    transform: translateY(-2px);
  }
  .form-block { margin: 2rem auto 4rem; }
  @media (max-width: 800px) {
    .area-grid { grid-template-columns: 1fr; }
  }
</style>
