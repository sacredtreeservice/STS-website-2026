---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import JobberForm from '../components/JobberForm.astro';
import QuickActions from '../components/QuickActions.astro';
import Stats from '../components/Stats.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { cities } from '../data/cities';
import { company } from '../data/company';

const featuredServices = services.slice(0, 6);
const cityShortlist = cities.slice(0, 12);
---

<Base
  title="Tree Care, Pruning & Plant Health in Orlando"
  description="ISA Certified Arborists in Orlando. Proactive tree care, pruning, plant health, and thoughtful removals across Central Florida. Family-owned, licensed & insured."
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="badge" data-reveal>
        <Icon name="lucide:shield-check" /> ISA Certified · Licensed &amp; Insured
      </span>
      <h1 data-reveal>
        Central Florida tree care, <span class="ink">done right.</span>
      </h1>
      <p class="lede" data-reveal>
        Proactive care for the trees that shape Central Florida — pruning,
        plant health, and thoughtful work when it’s time. Family-owned,
        ISA Certified, fully insured.
      </p>
      <div class="cta" data-reveal>
        <a class="btn primary large" href={company.phoneHref}>
          <Icon name="lucide:phone" /> Call {company.phone}
        </a>
        <a class="btn ghost large" href="/contact/">
          <Icon name="lucide:clipboard-check" /> Free Estimate
        </a>
      </div>
    </div>
  </section>

  <QuickActions />

  <section class="container svc-section">
    <header class="section-head" data-reveal>
      <span class="kicker">What we do</span>
      <h2>Care for every stage of a tree's life</h2>
      <p>From routine pruning and plant health, through removals and replanting — all under one crew.</p>
    </header>
    <div class="cards" data-reveal data-reveal-stagger>
      {featuredServices.map((s) => (
        <a class="card" href={`/services/${s.slug}/`}>
          <span class="ico"><Icon name={s.icon} /></span>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
          <span class="more">
            Learn more <Icon name="lucide:arrow-right" />
          </span>
        </a>
      ))}
    </div>
    <div class="more-link">
      <a class="btn ghost" href="/services/">All services <Icon name="lucide:arrow-right" /></a>
    </div>
  </section>

  <Stats />

  <Process />

  <Gallery />

  <section class="container area-section">
    <div class="area-grid">
      <div class="area-text" data-reveal>
        <span class="kicker">Service area</span>
        <h2>50 miles around Orlando</h2>
        <p>
          We work across <strong>Orange, Seminole, Lake, Osceola, Volusia,
          Brevard, and Polk</strong> counties. Same crew, same standards, no
          out-of-area surcharges.
        </p>
        <a class="btn ghost" href="/service-area/">
          <Icon name="lucide:map" /> See all cities
        </a>
      </div>
      <ul class="cloud" data-reveal data-reveal-stagger>
        {cityShortlist.map((c) => (
          <li><a href={`/service-area/${c.slug}/`}>{c.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />

  <section class="container narrow form-block">
    <JobberForm context="General estimate" />
  </section>
</Base>

<style>
  .hero {
    position: relative;
    color: #fff;
    padding: 6rem 1.25rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: -10%;
    background:
      linear-gradient(rgba(20, 30, 15, 0.55), rgba(20, 30, 15, 0.78)),
      url('/assets/hero.jpg') center/cover no-repeat;
    z-index: -1;
    animation: heroFloat 18s ease-in-out infinite alternate;
  }
  @keyframes heroFloat {
    from { transform: scale(1.04) translate(0, 0); }
    to   { transform: scale(1.08) translate(-2%, -1%); }
  }
  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    color: #e8efe0;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .badge [data-icon] { width: 14px; height: 14px; color: #b9d093; }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.2rem, 5.5vw, 3.5rem);
    margin: 0 0 1rem;
    letter-spacing: -0.015em;
  }
  .hero h1 .ink {
    background: linear-gradient(120deg, #b9d093 0%, #8fd0a5 50%, #68ccd1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .lede {
    font-size: 1.15rem;
    color: #e8efe0;
    margin: 0 auto 2rem;
    max-width: 56ch;
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero .btn.primary { background: #ffffff; color: #1a2110; }
  .hero .btn.primary:hover { background: #f3f1eb; color: #1a2110; }
  .hero .btn.ghost { color: #fff; border-color: rgba(255,255,255,0.5); }
  .hero .btn.ghost:hover { background: rgba(255,255,255,0.1); border-color: #fff; }

  .svc-section { padding: 5rem 1.25rem; }
  .section-head { text-align: center; margin: 0 0 2.5rem; }
  .kicker {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  .section-head h2 { font-size: 2.2rem; margin: 0 0 0.4rem; }
  .section-head p { color: var(--muted); margin: 0; }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s var(--easing), box-shadow 0.25s ease, border-color 0.2s ease;
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 60%, rgba(75, 112, 33, 0.04));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(75, 112, 33, 0.35);
  }
  .card:hover::before { opacity: 1; }
  .card .ico {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(75, 112, 33, 0.12), rgba(104, 204, 209, 0.1));
    color: var(--green-dark);
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
  }
  .card .ico [data-icon] { width: 28px; height: 28px; }
  .card h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }
  .card p { color: var(--muted); margin: 0 0 1rem; font-size: 0.95rem; }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--green);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .more [data-icon] { width: 16px; height: 16px; transition: transform 0.2s var(--easing); }
  .card:hover .more [data-icon] { transform: translateX(3px); }
  .more-link { text-align: center; margin-top: 2rem; }
  .more-link .btn { display: inline-flex; gap: 0.4rem; }
  .more-link .btn [data-icon] { width: 16px; height: 16px; }

  .area-section { padding: 4rem 1.25rem; }
  .area-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    align-items: center;
  }
  .area-text h2 { font-size: 2rem; margin: 0 0 1rem; }
  .area-text p { color: var(--muted); margin: 0 0 1.5rem; max-width: 40ch; }
  .area-text .btn { display: inline-flex; gap: 0.4rem; }
  .area-text .btn [data-icon] { width: 16px; height: 16px; }
  .cloud {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cloud li a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(75, 112, 33, 0.25);
    border-radius: 999px;
    text-decoration: none;
    color: var(--green-dark);
    background: var(--surface);
    font-size: 0.9rem;
    transition: all 0.2s var(--easing);
  }
  .cloud li a:hover {
    background: var(--green);
    color: var(--ink-strong);
    border-color: var(--green);
    transform: translateY(-2px);
  }
  .form-block { margin: 2rem auto 4rem; }
  @media (max-width: 800px) {
    .area-grid { grid-template-columns: 1fr; }
  }
</style>
