---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import TrustStrip from '../components/TrustStrip.astro';
import WhyUs from '../components/WhyUs.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import LatestPosts from '../components/LatestPosts.astro';
import QuickFacts from '../components/QuickFacts.astro';
import CtaBand from '../components/CtaBand.astro';
import heroImage from '../assets/hero.jpg';
import { services, type Service } from '../data/services';
import { cities } from '../data/cities';
import { company } from '../data/company';

// Curated homepage feature set — tells the "every stage of a tree's life"
// story (plant → prune → maintain → remove & replant) and surfaces the new
// Tree Planting line up front, which slice(0,6) would otherwise bury.
const featuredSlugs = [
  'tree-pruning',
  'tree-planting',
  'plant-health-care',
  'tree-removal',
  'palm-tree-services',
  'stump-grinding',
];
const featuredServices = featuredSlugs
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is Service => Boolean(s));

const cityBySlug = new Map(cities.map((c) => [c.slug, c]));
const pick = (...slugs: string[]) =>
  slugs.map((s) => cityBySlug.get(s)).filter((c): c is (typeof cities)[number] => Boolean(c));

const regions = [
  {
    name: 'Orlando Metro',
    subtitle: 'Orange County · core service ring',
    countyHref: '/service-area/orange-county/',
    cities: pick(
      'orlando',
      'winter-park',
      'maitland',
      'apopka',
      'ocoee',
      'winter-garden',
      'windermere',
      'dr-phillips',
      'hunters-creek',
      'lake-nona',
    ),
  },
  {
    name: 'North Metro · Seminole County',
    subtitle: 'Lake Mary · Sanford · Oviedo',
    countyHref: '/service-area/seminole-county/',
    cities: pick(
      'altamonte-springs',
      'longwood',
      'casselberry',
      'lake-mary',
      'sanford',
      'oviedo',
    ),
  },
  {
    name: 'South Metro · Osceola County',
    subtitle: 'Kissimmee · Celebration · St. Cloud',
    countyHref: '/service-area/osceola-county/',
    cities: pick('kissimmee', 'celebration', 'st-cloud'),
  },
  {
    name: 'Lake County (Northwest)',
    subtitle: 'Clermont · Mount Dora · the lakes region',
    countyHref: '/service-area/lake-county/',
    cities: pick('clermont', 'mount-dora', 'eustis', 'tavares', 'leesburg', 'minneola', 'groveland', 'four-corners'),
  },
  {
    name: 'Volusia County (Northeast)',
    subtitle: 'Deltona · DeBary · DeLand',
    countyHref: '/service-area/volusia-county/',
    cities: pick('deltona', 'debary', 'deland', 'orange-city'),
  },
  {
    name: 'Space Coast — Brevard County',
    subtitle: 'Titusville · Cocoa · Indian River corridor',
    countyHref: '/service-area/brevard-county/',
    cities: pick('titusville', 'cocoa'),
  },
  {
    name: 'Polk County (Four Corners)',
    subtitle: 'Davenport · Haines City',
    countyHref: '/service-area/polk-county/',
    cities: pick('davenport', 'haines-city'),
  },
];
---

<Base
  title="Tree Care, Pruning & Plant Health in Orlando"
  description="Sacred Tree Service — professional tree care in Orlando. Proactive pruning, plant health, planting, and thoughtful removals across Central Florida. Licensed &amp; insured, free estimates."
>
  <section class="hero">
    <Picture
      src={heroImage}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      pictureAttributes={{ class: 'hero-bg', 'aria-hidden': 'true' }}
    />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-inner">
      <span class="eyebrow" data-reveal>
        <span class="dot"></span>
        Professional Tree Care · Greater Orlando · Since 2023
      </span>

      <h1 data-reveal>
        Tree care for the trees that
        <span class="ink">shape your world.</span>
      </h1>

      <p class="lede" data-reveal>
        Proactive pruning, plant health, and thoughtful work when it’s
        time — by a crew that would rather save your tree than sell
        you a removal.
      </p>

      <div class="cta" data-reveal>
        <a class="btn primary large" href="/contact/">
          <Icon name="lucide:clipboard-check" /> Free Estimate
        </a>
        <a class="btn ghost large" href={company.phoneHref}>
          <Icon name="lucide:phone" /> {company.phone}
        </a>
      </div>

      <div class="hero-meta" data-reveal>
        <span><Icon name="lucide:shield" /> Licensed &amp; Insured</span>
        <span class="dot-sep" aria-hidden="true">·</span>
        <span><Icon name="lucide:star" /> 5.0★ on Google</span>
        <span class="dot-sep" aria-hidden="true">·</span>
        <span><Icon name="lucide:landmark" /> ISA &amp; TCIA Member</span>
      </div>
    </div>

    <a class="scroll-cue" href="#what-we-do" aria-label="Scroll down">
      <Icon name="lucide:chevron-down" />
    </a>
  </section>

  <TrustStrip />

  <!-- Answer-first definitional block: the first entity-rich, extractable
       description of the business in DOM order. AI engines weight opening
       content heavily when summarizing "what is / who is the best" queries. -->
  <section class="container intro-block" aria-label="About Sacred Tree Service">
    <p data-reveal>
      <strong>Sacred Tree Service</strong> is a professional tree care company
      based in Apopka, FL, serving the greater Orlando area within a 50-mile
      radius — pruning, plant health, tree planting with years of ongoing
      care, thoughtful removals, and storm response. Corporately small: a
      small company built on the fundamentals of tree care, defined processes,
      and repeatable results. Licensed and insured, rated 5.0 stars on Google.
      Free in-person estimates: <a href={company.phoneHref}>{company.phone}</a>.
    </p>
  </section>

  <section id="what-we-do" class="container svc-section">
    <header class="section-head" data-reveal>
      <span class="kicker">What we do</span>
      <h2>Care for every stage of a tree's life</h2>
      <p>From routine pruning and plant health, through removals and replanting — all under one crew.</p>
    </header>
    <div class="cards" data-reveal data-reveal-stagger>
      {featuredServices.map((s) => (
        <a class="card" href={`/services/${s.slug}/`}>
          <span class="ico"><Icon name={s.icon} /></span>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
          <span class="more">Learn more <Icon name="lucide:arrow-right" /></span>
        </a>
      ))}
    </div>
    <div class="more-link">
      <a class="btn ghost" href="/services/">All services <Icon name="lucide:arrow-right" /></a>
    </div>
  </section>

  <WhyUs />

  <Process />

  <section class="lifecycle-band">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="kicker">Plant with us, grow with us</span>
        <h2>We plant trees — then keep them thriving for years.</h2>
        <p>
          Most companies plant and leave. We source locally grown trees, plant
          them right, walk them through the establishment years, and stay on as
          your arborist team — the full life of the tree, one crew.
        </p>
      </header>
      <ol class="lifecycle" data-reveal data-reveal-stagger>
        <li>
          <span class="step-n">1</span>
          <h3><a href="/services/tree-planting/">Plant it right</a></h3>
          <p>
            Locally grown, locally sourced trees — delivered and installed by
            our own crew, same-day with a removal or on their own. Right tree,
            right place, every time.
          </p>
        </li>
        <li>
          <span class="step-n">2</span>
          <h3><a href="/tree-care/new-tree-care/">Establish it, years 1–2</a></h3>
          <p>
            The years that decide whether a young tree makes it. Watering tuned
            to sandy Florida soil, transplant-stress monitoring, mulch, staking
            removal, and formative pruning.
          </p>
        </li>
        <li>
          <span class="step-n">3</span>
          <h3><a href="/services/tree-care-plans/">Care for it, every year</a></h3>
          <p>
            An annual arborist walk, seasonal plant health monitoring, and
            storm-season prep on a simple year-to-year plan — problems caught
            while they're still cheap to fix.
          </p>
        </li>
      </ol>
      <div class="lifecycle-cta" data-reveal>
        <a class="btn primary" href="/services/tree-care-plans/">
          Explore Tree Care Plans <Icon name="lucide:arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <Testimonials />

  <Gallery />

  <LatestPosts />

  <QuickFacts />

  <section class="container area-section">
    <div class="area-grid">
      <header class="area-text" data-reveal>
        <span class="kicker">Service area</span>
        <h2>Professional tree care across Greater Orlando &amp; Central Florida</h2>
        <p>
          Centrally located in Apopka, FL, we serve homeowners, HOAs, and
          commercial properties across the seven-county Central Florida
          region — Orange, Seminole, Osceola, Lake, Volusia, Brevard, and
          northern Polk. Same crew, same process, same standards — everywhere
          inside our 50-mile radius.
        </p>
      </header>

      <div class="region-grid" data-reveal data-reveal-stagger>
        {regions.map((r) => (
          <article class="region">
            <h3><a href={r.countyHref}>{r.name}</a></h3>
            <p class="region-meta" set:html={r.subtitle} />
            <ul class="region-cities">
              {r.cities.map((c) => (
                <li><a href={`/service-area/${c.slug}/`}>{c.name}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <a class="btn ghost" href="/service-area/">
        <Icon name="lucide:map" /> Browse all cities &amp; neighborhoods
      </a>
    </div>
  </section>

  <CtaBand />

  <section class="container emergency-strip" aria-label="Emergency tree service">
    <p data-reveal>
      <Icon name="lucide:cloud-lightning" />
      <span>
        <strong>Tree down? Storm damage?</strong> We answer 24/7 for true
        emergencies — <a href="/emergency/">see our emergency response</a> or
        call <a href={company.phoneHref}>{company.phone}</a>.
      </span>
    </p>
  </section>

  <section class="container narrow form-block">
    <BookingForm context="General estimate" />
    <p class="financing-note">
      Larger project? <a href="/financing/">Financing is available</a> on major
      tree work.
    </p>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    color: #fff;
    padding: 7rem 1.25rem 6rem;
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(560px, 76vh, 760px);
    display: flex;
    align-items: center;
  }
  .hero-bg {
    position: absolute;
    inset: -8%;
    z-index: -2;
    display: block;
    animation: heroFloat 22s ease-in-out infinite alternate;
  }
  .hero-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(20, 30, 15, 0.45) 0%, rgba(20, 30, 15, 0.7) 60%, rgba(20, 30, 15, 0.92) 100%);
    pointer-events: none;
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 50% 0%, transparent 0%, rgba(0,0,0,0.0) 40%, rgba(8, 14, 12, 0.45) 100%);
    pointer-events: none;
  }
  @keyframes heroFloat {
    from { transform: scale(1.04) translate(0, 0); }
    to   { transform: scale(1.08) translate(-1.5%, -1%); }
  }
  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.18);
    color: #e8efe0;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 1.75rem;
    text-transform: uppercase;
  }
  .eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #b9d093;
    box-shadow: 0 0 0 4px rgba(185, 208, 147, 0.18);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .hero h1 .ink {
    background: linear-gradient(110deg, #b9d093 0%, #a6dbbe 50%, #6dcaa3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
  }
  .lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: #d8e1d3;
    margin: 0 auto 2rem;
    max-width: 60ch;
    line-height: 1.55;
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .hero .btn.primary { background: #ffffff; color: #1a2110; }
  .hero .btn.primary:hover { background: #f3f1eb; color: #1a2110; }
  .hero .btn.ghost {
    color: #fff;
    border-color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .hero .btn.ghost:hover { background: rgba(255,255,255,0.12); border-color: #fff; }

  .hero-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1rem;
    color: rgba(255,255,255,0.78);
    font-size: 0.85rem;
  }
  .hero-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-meta [data-icon] { width: 14px; height: 14px; color: #b9d093; }
  .dot-sep { opacity: 0.4; }
  @media (max-width: 600px) {
    .dot-sep { display: none; }
  }

  .scroll-cue {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.25);
    display: grid;
    place-items: center;
    animation: bounce 2.5s ease-in-out infinite;
    transition: all 0.2s var(--easing);
  }
  .scroll-cue:hover { background: rgba(255,255,255,0.12); color: #fff; }
  .scroll-cue [data-icon] { width: 18px; height: 18px; }
  @keyframes bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }

  /* Answer-first intro block — visually quiet, early in the DOM. */
  .intro-block {
    padding: 2.25rem 1.25rem 0;
    max-width: 880px;
  }
  .intro-block p {
    margin: 0;
    text-align: center;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.7;
  }
  .intro-block strong { color: var(--green-dark); }
  .intro-block a { color: var(--green-dark); font-weight: 700; text-decoration: none; }
  .intro-block a:hover { text-decoration: underline; }

  /* Plant → Establish → Care lifecycle band */
  .lifecycle-band {
    padding: 5rem 0;
    background: var(--paper-2);
  }
  .lifecycle {
    list-style: none;
    padding: 0;
    margin: 0 0 2.25rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .lifecycle li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.85rem;
    position: relative;
  }
  .step-n {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--green-tint), color-mix(in srgb, var(--teal) 18%, transparent));
    color: var(--green-dark);
    font-family: 'Marcellus', Georgia, serif;
    font-size: 1.3rem;
    margin-bottom: 0.9rem;
  }
  .lifecycle h3 { font-size: 1.2rem; margin: 0 0 0.4rem; }
  .lifecycle h3 a {
    color: var(--green-dark);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .lifecycle h3 a:hover { border-bottom-color: var(--green); }
  .lifecycle p { color: var(--muted); margin: 0; font-size: 0.95rem; line-height: 1.6; }
  .lifecycle-cta { text-align: center; }
  .lifecycle-cta .btn { display: inline-flex; gap: 0.4rem; }
  .lifecycle-cta .btn [data-icon] { width: 16px; height: 16px; }
  @media (max-width: 900px) {
    .lifecycle { grid-template-columns: 1fr; }
  }

  /* Slim emergency strip */
  .emergency-strip { padding: 0 1.25rem; margin: 2.5rem auto 0; max-width: 880px; }
  .emergency-strip p {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--warning);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  .emergency-strip [data-icon] { width: 22px; height: 22px; color: var(--warning); flex-shrink: 0; }
  .emergency-strip a { color: var(--green-dark); font-weight: 700; }

  .financing-note {
    text-align: center;
    color: var(--muted);
    font-size: 0.92rem;
    margin: 1rem 0 0;
  }
  .financing-note a { color: var(--green-dark); font-weight: 700; }

  .svc-section { padding: 5rem 1.25rem; }
  .section-head { text-align: center; margin: 0 auto 2.5rem; max-width: 60ch; }
  .kicker {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  .section-head h2 { font-size: clamp(1.8rem, 3.6vw, 2.4rem); margin: 0 0 0.4rem; }
  .section-head p { color: var(--muted); margin: 0; }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.85rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.25s var(--easing), box-shadow 0.3s ease, border-color 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 60%, rgba(75, 112, 33, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .card:hover::before { opacity: 1; }
  .card .ico {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--green-tint), color-mix(in srgb, var(--teal) 18%, transparent));
    color: var(--green-dark);
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
  }
  .card .ico [data-icon] { width: 28px; height: 28px; }
  .card h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }
  .card p { color: var(--muted); margin: 0 0 1rem; font-size: 0.95rem; }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--green);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .more [data-icon] { width: 16px; height: 16px; transition: transform 0.2s var(--easing); }
  .card:hover .more [data-icon] { transform: translateX(3px); }
  .more-link { text-align: center; margin-top: 2rem; }
  .more-link .btn { display: inline-flex; gap: 0.4rem; }
  .more-link .btn [data-icon] { width: 16px; height: 16px; }

  .area-section { padding: 5rem 1.25rem; }
  .area-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
  }
  .area-text { max-width: 70ch; }
  .area-text h2 { font-size: clamp(1.8rem, 3.6vw, 2.4rem); margin: 0 0 1rem; }
  .area-text p { color: var(--muted); margin: 0 auto; max-width: 65ch; }
  .area-grid > .btn { display: inline-flex; gap: 0.4rem; }
  .area-grid > .btn [data-icon] { width: 16px; height: 16px; }

  .region-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    width: 100%;
    text-align: left;
  }
  .region {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem 1.4rem;
    transition: border-color 0.2s ease, box-shadow 0.25s ease, transform 0.2s var(--easing);
  }
  .region:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }
  .region h3 {
    font-size: 1.1rem;
    margin: 0 0 0.3rem;
  }
  .region h3 a {
    color: var(--green-dark);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .region h3 a:hover { border-bottom-color: var(--green); }
  .region-meta {
    margin: 0 0 0.85rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .region-cities {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .region-cities li a {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border-strong);
