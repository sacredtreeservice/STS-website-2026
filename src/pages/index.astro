---
import Base from '../layouts/Base.astro';
import JobberForm from '../components/JobberForm.astro';
import { services } from '../data/services';
import { cities } from '../data/cities';
import { company } from '../data/company';

const featuredServices = services.slice(0, 6);
const cityShortlist = cities.slice(0, 12);
---

<Base
  title="Tree Removal, Pruning & Tree Care in Orlando"
  description="ISA Certified Arborists in Orlando. Tree removal, pruning, stump grinding, and emergency storm response across Central Florida. Licensed & insured."
>
  <section class="hero">
    <div class="hero-inner">
      <h1>Central Florida tree care, done right.</h1>
      <p class="lede">
        Tree removal, pruning, and emergency response from ISA Certified
        Arborists. Family-owned, fully insured, serving the Orlando area within
        a 50-mile radius of our HQ.
      </p>
      <div class="cta">
        <a class="btn primary" href={company.phoneHref}>Call {company.phone}</a>
        <a class="btn ghost" href="/contact/">Request a Free Estimate</a>
      </div>
      <ul class="trust">
        <li>ISA Certified Arborists</li>
        <li>ISA &amp; TCIA Member</li>
        <li>Licensed &amp; Insured</li>
        <li>Family-Owned, Orlando-Based</li>
      </ul>
    </div>
  </section>

  <section class="container svc-grid">
    <header class="section-head">
      <h2>What we do</h2>
      <p>Full-service tree care for Central Florida homes, estates, and properties.</p>
    </header>
    <div class="cards">
      {featuredServices.map((s) => (
        <a class="card" href={`/services/${s.slug}/`}>
          <span class="icon" aria-hidden="true">{s.icon}</span>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
          <span class="more">Learn more →</span>
        </a>
      ))}
    </div>
    <div style="text-align:center; margin-top:1.5rem;">
      <a class="btn ghost" href="/services/">All Services</a>
    </div>
  </section>

  <section class="container area">
    <header class="section-head">
      <h2>Where we work</h2>
      <p>50 miles around Orlando. Click a city for local service details.</p>
    </header>
    <ul class="city-cloud">
      {cityShortlist.map((c) => (
        <li><a href={`/service-area/${c.slug}/`}>{c.name}</a></li>
      ))}
      <li><a class="more" href="/service-area/">All cities →</a></li>
    </ul>
  </section>

  <section class="container narrow form-block">
    <JobberForm context="General estimate" />
  </section>
</Base>

<style>
  .hero {
    background:
      linear-gradient(rgba(20, 30, 15, 0.55), rgba(20, 30, 15, 0.75)),
      url('/assets/hero.jpg') center/cover no-repeat;
    color: #fff;
    padding: 5rem 1.25rem 4rem;
  }
  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem;
  }
  .lede {
    font-size: 1.15rem;
    color: #e8efe0;
    margin: 0 auto 1.75rem;
    max-width: 56ch;
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .hero .btn.ghost { color: #fff; border-color: #fff; }
  .hero .btn.ghost:hover { background: rgba(255,255,255,0.1); }
  .trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .trust li {
    font-size: 0.85rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }
  .section-head {
    text-align: center;
    margin: 3.5rem 0 2rem;
  }
  .section-head h2 { font-size: 2rem; margin: 0 0 0.4rem; }
  .section-head p { color: var(--muted); margin: 0; }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: block;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(0,0,0,0.07);
    border-color: rgba(75, 112, 33, 0.35);
  }
  .icon { font-size: 2rem; }
  .card h3 { margin: 0.6rem 0 0.4rem; font-size: 1.2rem; }
  .card p { color: var(--muted); margin: 0 0 0.85rem; font-size: 0.92rem; }
  .more { color: var(--green); font-weight: 700; font-size: 0.9rem; }

  .city-cloud {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .city-cloud li a {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    border: 1px solid rgba(75, 112, 33, 0.25);
    border-radius: 999px;
    text-decoration: none;
    color: var(--green-dark);
    font-size: 0.9rem;
    background: rgba(75, 112, 33, 0.04);
  }
  .city-cloud li a:hover { background: rgba(75, 112, 33, 0.12); }
  .form-block { margin: 4rem auto; }
</style>
