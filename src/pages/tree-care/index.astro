---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Tree Care', url: '/tree-care/' },
];

// Educational topic clusters. Pages with an `href` are live guides; the rest
// are placeholders that render as plain "coming soon" cards.
const pillars = [
  { slug: 'florida-tree-species', title: 'Florida Tree Species', blurb: 'Live oak, sabal palm, magnolia, citrus, pine — care needs and ID.', href: '/tree-care/florida-tree-species/' },
  { slug: 'storm-prep', title: 'Storm & Hurricane Prep', blurb: 'How to prepare trees for hurricane season — and what to do after.' },
  { slug: 'pruning-basics', title: 'Pruning Basics', blurb: 'When to prune, what topping does, and the ANSI A300 standard.', href: '/tree-care/pruning-basics/' },
  { slug: 'tree-removal-decisions', title: 'Should I Remove This Tree?', blurb: 'How arborists decide between removal, pruning, and preservation.' },
  { slug: 'cost-guides', title: 'Cost Guides', blurb: 'What tree work actually costs in Central Florida, and why prices vary.' },
  { slug: 'pests-and-diseases', title: 'Pests &amp; Diseases', blurb: 'Lethal bronzing, oak wilt, beetles — what to watch for in Florida.' },
];
---

<Base
  title="Tree Care Education — Florida Tree Owner's Guide"
  description="Educational guides on Florida tree species, pruning, storm prep, costs, and pest/disease identification — written by ISA Certified Arborists."
  breadcrumbs={trail}
>
  <div class="container">
    <Breadcrumbs trail={trail} />
    <header class="head">
      <h1>Tree Care Education</h1>
      <p class="lede">
        Practical, no-fluff guides for Central Florida tree owners — from
        species ID to storm prep to cost expectations. Written by ISA Certified
        Arborists.
      </p>
    </header>

    <div class="pillars">
      {pillars.map((p) => (
        p.href ? (
          <a class="card card-link" href={p.href}>
            <h2>{p.title}</h2>
            <p set:html={p.blurb} />
            <span class="more read">Read guide →</span>
          </a>
        ) : (
          <div class="card">
            <h2>{p.title}</h2>
            <p set:html={p.blurb} />
            <span class="more">Coming soon</span>
          </div>
        )
      ))}
    </div>

    <p class="todo">
      <em>Pillar pages are being written. In the meantime, head to <a href="/blog/">the blog</a> for field notes — or <a href="/contact/">ask us a question</a> and we’ll cover it.</em>
    </p>
  </div>
</Base>

<style>
  .head { text-align: center; max-width: 65ch; margin: 1rem auto 2.5rem; }
  h1 { font-size: 2.5rem; margin: 0 0 0.75rem; }
  .lede { color: var(--muted); font-size: 1.1rem; margin: 0 auto; }
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    color: var(--ink);
  }
  .card h2 { font-size: 1.2rem; margin: 0 0 0.5rem; }
  .card p { color: var(--muted); margin: 0 0 0.85rem; font-size: 0.95rem; }
  .card-link {
    text-decoration: none;
    transition: transform 0.25s var(--easing), border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .card-link:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }
  .more {
    display: inline-block;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--green-tint);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .more.read { color: var(--green-dark); }
  .card-link:hover .more.read { background: var(--green-dark); color: #fff; }
  .todo a { color: var(--green-dark); font-weight: 700; }
  .todo {
    margin-top: 3rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border-left: 3px solid var(--muted);
    color: var(--muted);
    font-size: 0.92rem;
    border-radius: 4px;
  }
</style>
