---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookingForm from '../../components/BookingForm.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { cities, SERVICE_AREA_UPDATED } from '../../data/cities';
import { services } from '../../data/services';
import { getCountyByName } from '../../data/counties';
import { faqSchema, webPageSchema } from '../../lib/schema';

export async function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug }, props: { city: c } }));
}

const { city } = Astro.props;

const isHood = Boolean(city.neighborhoodOf);
const placeLine = isHood ? `${city.name}, a neighborhood of ${city.neighborhoodOf}, FL` : `${city.name}, FL`;
const placeShort = isHood ? `${city.name}, ${city.neighborhoodOf}` : `${city.name}, FL`;
const areaLine = isHood ? `${city.name} and the surrounding ${city.neighborhoodOf} area` : `${city.name} and ${city.county} County`;

const url = `/service-area/${city.slug}/`;
const trail = [
  { name: 'Home', url: '/' },
  { name: 'Service Area', url: '/service-area/' },
  { name: city.name, url },
];

// Tier-1 places carry a page per core service; everywhere else the service
// link goes to the main service page (the work is the same, the page isn't
// duplicated).
const coreServices = services.filter((s) => s.tier === 1);
const moreServices = services.filter((s) => s.tier !== 1);
const serviceHref = (slug: string) => (city.tier === 1 ? `/services/${slug}/${city.slug}/` : `/services/${slug}/`);

const faqs = [
  { q: `Does Sacred Tree Service work in ${city.name}${isHood ? '' : ', FL'}?`,
    a: isHood
      ? `Yes. ${city.name} is a neighborhood of ${city.neighborhoodOf}${city.zip ? ` (ZIP ${city.zip})` : ''} and one of the areas where we work most. We're based in Apopka, FL, about ${city.miles} miles away — well inside our 50-mile service radius.`
      : `Yes. ${city.name} sits well within the greater Orlando area we serve from our Apopka, FL base — about ${city.miles} miles away, inside our 50-mile service radius. We provide full tree care services across ${city.county} County.` },
  { q: `What tree services are available in ${city.name}?`,
    a: 'We provide tree removal, pruning, stump grinding, tree planting, palm tree services, land clearing, plant health care, cabling and bracing, crane-assisted removal, arborist consulting, and emergency storm response.' },
  { q: 'How do I request an estimate?',
    a: `Call (321) 204-8459 or submit the form on this page. We schedule free in-person estimates in ${city.name} typically within 1–3 business days.` },
];

const localHook = city.hook ?? `Sacred Tree Service has worked across ${areaLine}, helping homeowners and property managers care for the trees that define their landscapes.`;

const county = getCountyByName(city.county);

const title = `Tree Service in ${placeShort}`;
const description = `Tree removal, pruning, stump grinding and palm care in ${placeLine}. Professional crew, licensed & insured. Free estimates.`;

const jsonLd = [faqSchema(faqs), webPageSchema({ url, name: title, description, dateModified: SERVICE_AREA_UPDATED })];

const updated = new Date(`${SERVICE_AREA_UPDATED}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={title} description={description} breadcrumbs={trail} jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs trail={trail} />

    <header class="head">
      <h1>Tree Service in {placeShort}</h1>
      <p class="lede">
        Professional tree care for {areaLine} from our Apopka, FL base —
        about {city.miles} miles away, well inside the greater Orlando area we cover.
      </p>
    </header>

    <div class="layout">
      <article>
        <p class="answer">{localHook}</p>

        {city.intro && <p>{city.intro}</p>}
        {city.species && city.species.length > 0 && (
          <p class="meta-line"><strong>Common trees &amp; palms in {city.name}:</strong> {city.species.join(', ')}.</p>
        )}
        {city.landmarks && city.landmarks.length > 0 && (
          <p class="meta-line"><strong>Areas we cover:</strong> {city.landmarks.join(', ')}.</p>
        )}
        {isHood && (
          <p class="meta-line">{city.name} is part of <a href="/service-area/orlando/">Orlando</a>{county && <>, in our <a href={`/service-area/${county.slug}/`}>{county.name}</a> service area</>}.</p>
        )}
        {!isHood && county && (
          <p class="meta-line">{city.name} is part of our <a href={`/service-area/${county.slug}/`}>{county.name}</a> service area.</p>
        )}

        <h2>Tree care services in {city.name}</h2>
        <ul class="services">
          {coreServices.map((s) => (
            <li>
              <a href={serviceHref(s.slug)}>
                <span class="ico" aria-hidden="true"><Icon name={s.icon} /></span>
                <span class="text">
                  <strong>{s.name}</strong>
                  <em>{s.shortName} in {city.name}</em>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <h3>Also available in {city.name}</h3>
        <ul class="services more">
          {moreServices.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`}>
                <span class="ico" aria-hidden="true"><Icon name={s.icon} /></span>
                <span class="text">
                  <strong>{s.name}</strong>
                  <em>{s.blurb}</em>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <h2>Why {city.name} property owners choose us</h2>
        <ul class="checks">
          <li>One process on every job — assessment, written scope, execution, cleanup.</li>
          <li>Member of ISA and TCIA — bound by national best-practice standards.</li>
          <li>Local to the Orlando area — one crew, fast scheduling across the metro.</li>
          <li>Fully licensed and insured with workers’ comp coverage.</li>
        </ul>

        <FaqBlock faqs={faqs} />

        <p class="updated">Page updated {updated}.</p>
      </article>

      <aside>
        <BookingForm
          heading={`Free Estimate in ${city.name}`}
          context={`${placeShort} — general tree service estimate`}
        />
      </aside>
    </div>
  </div>
</Base>

<style>
  .head { text-align: center; max-width: 65ch; margin: 1rem auto 2rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0 0 0.6rem; }
  .lede { color: var(--muted); font-size: 1.1rem; margin: 0 auto; }
  .answer {
    background: var(--surface);
    border-left: 4px solid var(--green);
    padding: 1rem 1.25rem;
    margin: 0 0 1.5rem;
    border-radius: 4px;
  }
  .meta-line {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0.5rem 0;
  }
  .meta-line strong { color: var(--green-dark); }
  .layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  article h2 { font-size: 1.5rem; margin: 2rem 0 0.85rem; }
  article h3 { font-size: 1.1rem; margin: 1.5rem 0 0.6rem; color: var(--green-dark); }
  .services {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .services a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    transition: all 0.2s var(--easing);
  }
  .services a:hover { border-color: rgba(75, 112, 33, 0.4); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .services .ico {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(75, 112, 33, 0.1);
    color: var(--green-dark);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .services .ico [data-icon] { width: 18px; height: 18px; }
  .services .text { display: flex; flex-direction: column; min-width: 0; }
  .services strong { color: var(--green-dark); }
  .services em {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .services.more a { padding: 0.6rem 0.85rem; }
  .services.more .ico { width: 30px; height: 30px; }
  .checks { list-style: none; padding: 0; }
  .checks li { padding-left: 1.5rem; position: relative; margin-bottom: 0.5rem; }
  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .updated { margin-top: 2rem; font-size: 0.85rem; color: var(--muted); }
  aside { position: sticky; top: 100px; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .services { grid-template-columns: 1fr; }
    aside { position: static; }
  }
</style>
