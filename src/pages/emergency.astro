---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookingForm from '../components/BookingForm.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { company } from '../data/company';
import { getServiceBySlug } from '../data/services';
import { faqSchema } from '../lib/schema';

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Emergency', url: '/emergency/' },
];

// The emergency-storm-damage service already carries the high-intent Q&A
// (insurance coverage, pricing honesty, what-to-do steps) — surface it here
// with FAQPage markup so this page answers extraction-style queries
// ("tree fell on my house Orlando who pays") on its own.
const emergencyFaqs = getServiceBySlug('emergency-storm-damage')!.faqs!;
const jsonLd = faqSchema(emergencyFaqs);
---

<Base
  title="Emergency Tree Service in Orlando"
  description="Storm damage, fallen trees, lightning strikes — fast emergency tree response across Central Florida. Call (321) 204-8459."
  breadcrumbs={trail}
  jsonLd={jsonLd}
>
  <div class="emergency-banner">
    <strong>If a tree is on a structure, blocking access, or is an immediate hazard — call now.</strong>
    <a class="btn-emergency" href={company.phoneHref}>📞 {company.phone}</a>
  </div>

  <div class="container">
    <Breadcrumbs trail={trail} />

    <header class="head">
      <h1>Emergency &amp; Storm Damage Tree Service</h1>
      <p class="lede">
        Hurricanes, lightning, microbursts, and rotten trees don’t wait. We
        respond fast across Central Florida — same-day during active storm
        events when possible.
      </p>
    </header>

    <div class="layout">
      <article>
        <h2>What counts as an emergency?</h2>
        <ul class="checks">
          <li>Tree on a house, garage, or other structure</li>
          <li>Tree blocking a driveway, road, or emergency access</li>
          <li>Major limb hanging dangerously over a roof or path</li>
          <li>Lightning-struck tree showing signs of immediate failure</li>
          <li>Hurricane or storm damage requiring rapid cleanup</li>
        </ul>

        <h2>What to do right now</h2>
        <ol class="steps">
          <li><strong>Stay clear of the tree.</strong> Don’t walk underneath it. Keep kids and pets back.</li>
          <li><strong>Avoid downed wires.</strong> If wires are involved, call the power company first.</li>
          <li><strong>Call us.</strong> {company.phone} — we’ll triage and dispatch as fast as we can.</li>
          <li><strong>Document for insurance.</strong> Take photos before any work begins.</li>
        </ol>

        <h2>How we prioritize</h2>
        <p>
          During major storm events demand spikes everywhere. We triage based
          on safety: trees on occupied structures and blocked emergency access
          go first. We will give you an honest ETA when you call — no false
          promises.
        </p>

        <FaqBlock faqs={emergencyFaqs} />

        <p class="prep-link">
          Not an emergency yet? The best storm response is the one you never
          need — see our guide to
          <a href="/tree-care/storm-prep/">preparing your trees for hurricane season</a>.
        </p>
      </article>

      <aside>
        <BookingForm
          heading="Emergency Request"
          subheading="For active emergencies, please CALL — forms are checked during business hours."
          context="EMERGENCY / Storm Damage"
        />
      </aside>
    </div>
  </div>
</Base>

<style>
  .emergency-banner {
    background: var(--warning);
    color: #fff;
    padding: 1rem 1.25rem;
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
  .btn-emergency {
    background: var(--surface);
    color: var(--warning);
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }
  .head { text-align: center; max-width: 60ch; margin: 1rem auto 2rem; }
  h1 { font-size: 2.5rem; margin: 0 0 0.6rem; }
  .lede { color: var(--muted); font-size: 1.15rem; margin: 0 auto; }
  .layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  article h2 { font-size: 1.5rem; margin: 2rem 0 0.85rem; }
  .checks { list-style: none; padding: 0; }
  .checks li { padding-left: 1.5rem; position: relative; margin-bottom: 0.5rem; }
  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.6rem; }
  .prep-link {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border-left: 3px solid var(--green);
    border-radius: 4px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .prep-link a { color: var(--green-dark); font-weight: 700; }
  aside { position: sticky; top: 100px; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    aside { position: static; }
  }
</style>
