---
import Base from '../layouts/Base.astro';
import BookCallEmbed from '../components/BookCallEmbed.astro';

// Hidden landing page for ad traffic — NOT linked from the main nav and kept
// out of search (noindex + excluded from the sitemap in astro.config.mjs).
// Per the Lantern Media thread: a clean, distraction-free page whose only job
// is the booking calendar. Hand this URL to Lantern for the ad campaigns.
// The site's main funnel stays phone-first (see BookCallEmbed.astro header).
---

<Base
  title="Book a Call with Sacred Tree Service"
  description="Schedule a call with Sacred Tree Service — pick a time that works for you and our office will call you then."
  noindex={true}
>
  <div class="narrow book-page">
    <header class="head">
      <h1>Let’s talk about your trees</h1>
      <p class="lede">
        Pick a time that works for you and our office will give you a quick call then —
        a short conversation about your project and the best next steps. No assessment,
        no pressure, just on your schedule instead of ours.
      </p>
    </header>

    <BookCallEmbed />
  </div>
</Base>

<style>
  .book-page { padding-top: 2rem; padding-bottom: 3rem; }
  .head { text-align: center; max-width: 56ch; margin: 0 auto 2rem; }
  .head h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 0 0 0.6rem; }
  .lede { color: var(--muted); font-size: 1.12rem; margin: 0 auto; }
</style>
